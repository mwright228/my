{
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-direct",
                "type": "local",
                "detour": "direct"
            }
        ],
        "strategy": "prefer_ipv4"
    },
    "inbounds": [
        {
            "type": "shadowtls",
            "tag": "stls-in",
            "listen": "127.0.0.1",
            "listen_port": 8448,
            "tcp_fast_open": true,
            "version": 3,
            "users": [
                {
                    "name": "mubx",
                    "password": "__SHADOWTLS_PASS__"
                }
            ],
            "handshake": {
                "server": "__SNI_FRONT__",
                "server_port": 443
            },
            "wildcard_sni": "all",
            "detour": "ss22-in"
        },
        {
            "type": "shadowsocks",
            "tag": "ss22-in",
            "listen": "127.0.0.1",
            "listen_port": 18500,
            "tcp_fast_open": true,
            "method": "2022-blake3-aes-256-gcm",
            "password": "__SS22_ADMIN_PASS__"
        },
        {
            "type": "tuic",
            "tag": "tuic-in",
            "listen": "::",
            "listen_port": 8444,
            "users": [
                {
                    "name": "admin",
                    "uuid": "__ADMIN_UUID__",
                    "password": "__ADMIN_UUID__"
                }
            ],
            "congestion_control": "bbr",
            "tls": {
                "enabled": true,
                "certificate_path": "/etc/letsencrypt/live/__DOMAIN__/fullchain.pem",
                "key_path": "/etc/letsencrypt/live/__DOMAIN__/privkey.pem"
            }
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "final": "direct"
    }
}
