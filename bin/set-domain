#!/bin/bash
set -euo pipefail
read -r -p "Domain: " d
d="${d,,}"
[ -z "$d" ] && { echo "Domain is required" >&2; exit 1; }
[[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] ||
  { echo "Invalid domain" >&2; exit 1; }
success=0
declare -A was_active=()
declare -A backups=()
declare -A absent=()
backup_dir="$(mktemp -d)"
backup_file() {
  local path="$1" target="$backup_dir${path}"
  if [ -f "$path" ] || [ -L "$path" ]; then
    install -d -m 0700 "$(dirname "$target")"
    cp -aP "$path" "$target"
    backups["$path"]=1
  else
    absent["$path"]=1
  fi
}
restore_files() {
  local path target status=0
  for path in "${!backups[@]}"; do
    target="$backup_dir${path}"
    if ! { rm -f "$path" && cp -aP "$target" "$path"; }; then
      printf '[!] Failed to restore %s\n' "$path" >&2
      status=1
    fi
  done
  for path in "${!absent[@]}"; do
    if ! rm -f "$path"; then
      printf '[!] Failed to remove %s\n' "$path" >&2
      status=1
    fi
  done
  return "$status"
}
for svc in hysteria zivpn nginx haproxy xray; do
  systemctl is-active --quiet "$svc" && was_active["$svc"]=1 || was_active["$svc"]=0
done
cleanup() {
  local status=$?
  if [ "$success" -eq 0 ]; then
    restore_files || status=1
    for svc in hysteria zivpn nginx haproxy xray; do
      if [ "${was_active[$svc]}" -eq 1 ] && ! systemctl start "$svc"; then
        printf '[!] Failed to restore %s\n' "$svc" >&2
        status=1
      fi
    done
  fi
  rm -rf -- "$backup_dir" || status=1
  return "$status"
}
trap cleanup EXIT
for path in /usr/local/etc/xray/domain /usr/local/etc/xray/config.json \
  /etc/telecom-engine.env /etc/nginx/nginx.conf /etc/hysteria/config.yaml \
  /etc/wireguard/mubx-client.conf \
  /etc/zivpn/zivpn.crt /etc/zivpn/zivpn.key; do
  backup_file "$path"
done
for profile in /etc/openvpn/client/mubx-client-*.ovpn; do
  [ -f "$profile" ] && backup_file "$profile"
done

# Prefer zero-downtime webroot renewal if Nginx is active on port 80.
# Fall back to stopping TLS/web services and using standalone if inactive or failed.
install -d -m 0755 /var/www/html
cert_obtained=0
if [ "${was_active[nginx]}" -eq 1 ]; then
  if certbot certonly --webroot -w /var/www/html --keep-until-expiring -d "$d" \
       --agree-tos --register-unsafely-without-email --non-interactive; then
    cert_obtained=1
  fi
fi

if [ "$cert_obtained" -eq 0 ]; then
  systemctl stop hysteria zivpn nginx haproxy 2>/dev/null || true
  certbot certonly --standalone --keep-until-expiring -d "$d" \
    --agree-tos --register-unsafely-without-email --non-interactive
fi

echo "$d" > /usr/local/etc/xray/domain
if [ -f /etc/telecom-engine.env ]; then
  sed -i "s/^DOMAIN=.*/DOMAIN=\"$d\"/" /etc/telecom-engine.env
fi
if [ -f /etc/nginx/nginx.conf ]; then
  sed -i "s|/etc/letsencrypt/live/[^/]*/|/etc/letsencrypt/live/$d/|g" /etc/nginx/nginx.conf
fi
if [ -f /etc/hysteria/config.yaml ]; then
  sed -i "s|/etc/letsencrypt/live/[^/]*/|/etc/letsencrypt/live/$d/|g" \
    /etc/hysteria/config.yaml
fi
# The rendered Xray config embeds the certificate path for the plain
# VLESS TCP+TLS (8443) inbound; re-point it at the new domain's cert.
if [ -f /usr/local/etc/xray/config.json ]; then
  sed -i "s|/etc/letsencrypt/live/[^/]*/|/etc/letsencrypt/live/$d/|g" \
    /usr/local/etc/xray/config.json
fi
if [ -d /etc/zivpn ]; then
  ln -sfn "/etc/letsencrypt/live/$d/fullchain.pem" /etc/zivpn/zivpn.crt
  ln -sfn "/etc/letsencrypt/live/$d/privkey.pem" /etc/zivpn/zivpn.key
fi
for profile in /etc/openvpn/client/mubx-client-*.ovpn; do
  [ -f "$profile" ] || continue
  sed -i -E "s/^remote [^ ]+ /remote $d /" "$profile"
done
if [ -f /etc/wireguard/mubx-client.conf ]; then
  sed -i -E "s/^Endpoint = .+:51820$/Endpoint = $d:51820/" \
    /etc/wireguard/mubx-client.conf
fi
nginx -t
haproxy -c -f /etc/haproxy/haproxy.cfg
xray run -test -config /usr/local/etc/xray/config.json
systemctl daemon-reload
for svc in nginx haproxy hysteria zivpn xray; do
  if [ "${was_active[$svc]}" -eq 1 ]; then
    if ! systemctl restart "$svc" || ! systemctl is-active --quiet "$svc"; then
      printf '[!] Failed to restart %s after domain migration\n' "$svc" >&2
      exit 1
    fi
  fi
done
success=1
rm -rf -- "$backup_dir"
trap - EXIT
