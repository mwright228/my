#!/usr/bin/env bash
set -Eeuo pipefail

[ "$(id -u)" -eq 0 ] || { echo "[!] Run mubx-update as root." >&2; exit 1; }
ROOT="$(cat /etc/mubx/install-root 2>/dev/null || true)"
[ -n "$ROOT" ] && [ -d "$ROOT/.git" ] || { echo "[!] MUB-X install root not found ($ROOT)." >&2; exit 1; }
REPO_URL="${MUBX_REPO_URL:-https://github.com/mwright228/my.git}"
SERVICES=(haproxy nginx xray dropbear wstunnel hysteria zivpn singbox mubx-chameleon mubx-tbrutal openvpn-server@tcp openvpn-server@udp wg-quick@wg0 badvpn@7100 badvpn@7200 badvpn@7300 badvpn@7400 badvpn@7500 badvpn@7600 badvpn@7700 mubx-cron.timer mubx-adaptive.timer mubx-probe.timer mubx-quota.timer)
source "$ROOT/lib/common.sh"
source "$ROOT/lib/mubx-transaction.sh"

usage(){ echo "Usage: mubx-update [--force|-f]"; }
FORCE=0
for arg in "$@"; do case "$arg" in --force|-f) FORCE=1;; -h|--help) usage; exit 0;; *) echo "[!] Unknown option: $arg" >&2; usage >&2; exit 2;; esac; done

canonical_repo_url(){ printf '%s\n' "$1" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#^[^/@]*@##' -e 's#\.git$##' -e 's#/$##'; }
origin="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
[ "$(canonical_repo_url "$origin")" = "$(canonical_repo_url "$REPO_URL")" ] || { echo "[!] Refusing update: origin does not match $REPO_URL." >&2; exit 1; }

if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
  [ "$FORCE" -eq 1 ] || { echo "[!] Local changes detected; commit them or rerun with --force." >&2; exit 1; }
  git -C "$ROOT" stash push -u -m "mubx-update-backup-$(date -u +%Y%m%dT%H%M%SZ)"
fi

OLD_HEAD="$(git -C "$ROOT" rev-parse HEAD)"
OLD_BRANCH="$(git -C "$ROOT" symbolic-ref --short -q HEAD || true)"
was_active=(); was_enabled=()
for svc in "${SERVICES[@]}"; do
  systemctl is-active --quiet "$svc" 2>/dev/null && was_active["$svc"]=1 || was_active["$svc"]=0
  systemctl is-enabled --quiet "$svc" 2>/dev/null && was_enabled["$svc"]=1 || was_enabled["$svc"]=0
done

mubx_tx_begin update
snapshot_repo_targets(){
  local f base
  for f in "$ROOT"/bin/*; do [ -f "$f" ] || continue; base="$(basename "$f")"; mubx_tx_snapshot "/usr/local/bin/$base"; done
  for f in "$ROOT"/lib/*.sh; do [ -f "$f" ] || continue; base="$(basename "$f")"; mubx_tx_snapshot "/usr/local/lib/mubx/$base"; done
  for f in "$ROOT"/systemd/*.service "$ROOT"/systemd/*.timer; do [ -f "$f" ] || continue; base="$(basename "$f")"; mubx_tx_snapshot "/etc/systemd/system/$base"; done
}
snapshot_repo_targets
mubx_tx_snapshot /etc/mubx/users.json
mubx_tx_snapshot_tree /var/www/mubx-sub
mubx_tx_snapshot_tree /etc/mubx/ss2022-keys
mubx_tx_snapshot_tree /etc/mubx/sub-tokens
for path in /usr/local/etc/xray/config.json /etc/haproxy/haproxy.cfg /etc/nginx/nginx.conf /etc/sing-box/config.json /etc/hysteria/config.yaml /etc/mubx/domain /usr/local/etc/xray/domain /usr/local/bin/reality-fronts /usr/local/lib/mubx/reality-build.sh /etc/systemd/system/dnstt.service /usr/local/bin/dnstt-server /usr/local/bin/dnstt-client /etc/dnstt/dnstt.priv /etc/dnstt/dnstt.pub /etc/squid/squid.conf; do mubx_tx_snapshot "$path"; done

TMP="$(mktemp -d)"
cleanup(){ rm -rf -- "$TMP"; }
trap cleanup EXIT
failed=1
rollback(){
  local status=$?
  if [ "$failed" -ne 0 ]; then
    echo "[!] Update failed; rolling back files, Git checkout, and service state." >&2
    for svc in "${SERVICES[@]}"; do systemctl stop "$svc" >/dev/null 2>&1 || true; done
    mubx_tx_abort || true
    git -C "$ROOT" reset --hard "$OLD_HEAD" >/dev/null 2>&1 || true
    if [ -n "$OLD_BRANCH" ]; then git -C "$ROOT" checkout -B "$OLD_BRANCH" "$OLD_HEAD" >/dev/null 2>&1 || true; fi
    systemctl daemon-reload >/dev/null 2>&1 || true
    for svc in "${SERVICES[@]}"; do
      if [ "${was_active[$svc]}" -eq 1 ]; then systemctl start "$svc" >/dev/null 2>&1 || true; fi
      if [ "${was_enabled[$svc]}" -eq 1 ]; then systemctl enable "$svc" >/dev/null 2>&1 || true; else systemctl disable "$svc" >/dev/null 2>&1 || true; fi
    done
  else
    mubx_tx_commit || status=1
  fi
  exit "$status"
}
trap rollback EXIT

printf '[*] Fetching latest updates from %s\n' "$REPO_URL"
timeout 25 git -C "$ROOT" fetch origin main
git -C "$ROOT" checkout -B main origin/main
git -C "$ROOT" reset --hard origin/main
snapshot_repo_targets

load_mubx_env
install_file(){ local src="$1" dst="$2" mode="$3"; mubx_tx_atomic_install "$src" "$dst" "$mode"; }
for f in "$ROOT"/lib/*.sh; do [ -f "$f" ] || continue; install_file "$f" "/usr/local/lib/mubx/$(basename "$f")" 0644; done
for f in "$ROOT"/systemd/*.service "$ROOT"/systemd/*.timer; do [ -f "$f" ] || continue; install_file "$f" "/etc/systemd/system/$(basename "$f")" 0644; done
for f in "$ROOT"/bin/*; do [ -f "$f" ] || continue; [ "$(basename "$f")" = mubx-update ] && continue; install_file "$f" "/usr/local/bin/$(basename "$f")" 0755; done

if [ -n "${SSH_WS_PATH:-}" ] && [ -f /etc/systemd/system/wstunnel.service ]; then
  sed "s|__SSH_WS_PATH__|$SSH_WS_PATH|g" /etc/systemd/system/wstunnel.service > "$TMP/wstunnel.service"
  install_file "$TMP/wstunnel.service" /etc/systemd/system/wstunnel.service 0644
fi

systemctl daemon-reload
source "$ROOT/lib/render.sh"
[ ! -r "$ROOT/lib/subscribe.sh" ] || source "$ROOT/lib/subscribe.sh"
mubx_users_seed
mubx_xray_render "$ROOT/configs/xray.json" "$TMP/xray.json"
mubx_haproxy_render "$ROOT/configs/haproxy.cfg" "$TMP/haproxy.cfg"
mubx_nginx_render "$ROOT/configs/nginx.conf" "$TMP/nginx.conf"
[ ! -f "$ROOT/configs/singbox.json" ] || mubx_singbox_render "$ROOT/configs/singbox.json" "$TMP/singbox.json"
[ ! -f "$ROOT/configs/hysteria.yaml" ] || mubx_hysteria_render "$ROOT/configs/hysteria.yaml" "$TMP/hysteria.yaml"
command -v xray >/dev/null 2>&1 && xray run -test -config "$TMP/xray.json" >/dev/null
command -v nginx >/dev/null 2>&1 && nginx -t -c "$TMP/nginx.conf" >/dev/null
command -v haproxy >/dev/null 2>&1 && haproxy -c -f "$TMP/haproxy.cfg" >/dev/null
[ ! -s "$TMP/singbox.json" ] || ! command -v sing-box >/dev/null 2>&1 || sing-box check -c "$TMP/singbox.json" >/dev/null
install_file "$TMP/xray.json" /usr/local/etc/xray/config.json 0600
install_file "$TMP/haproxy.cfg" /etc/haproxy/haproxy.cfg 0644
install_file "$TMP/nginx.conf" /etc/nginx/nginx.conf 0644
if [ -s "$TMP/singbox.json" ]; then install -d -m 0755 /etc/sing-box; install_file "$TMP/singbox.json" /etc/sing-box/config.json 0600; fi
if [ -s "$TMP/hysteria.yaml" ] && [ -d /etc/hysteria ]; then install_file "$TMP/hysteria.yaml" /etc/hysteria/config.yaml 0600; fi

if [ -r "$ROOT/lib/subscribe.sh" ] && [ -f /etc/mubx/users.json ]; then
  while IFS= read -r sub_user; do [ -n "$sub_user" ] || continue; mubx_sub_generate "$sub_user" >/dev/null; done < <(jq -r '.[].name' /etc/mubx/users.json)
fi

for svc in "${SERVICES[@]}"; do
  [ "${was_active[$svc]}" -eq 1 ] || continue
  systemctl cat "$svc.service" >/dev/null 2>&1 || continue
  timeout 10 systemctl restart "$svc" >/dev/null
  systemctl is-active --quiet "$svc"
done

xray run -test -config /usr/local/etc/xray/config.json >/dev/null
nginx -t >/dev/null
haproxy -c -f /etc/haproxy/haproxy.cfg >/dev/null
[ ! -s /etc/sing-box/config.json ] || ! command -v sing-box >/dev/null 2>&1 || sing-box check -c /etc/sing-box/config.json >/dev/null

install_file "$ROOT/bin/mubx-update" /usr/local/bin/mubx-update 0755
failed=0
printf '\n[*] MUB-X update committed at %s\n' "$(git -C "$ROOT" log -1 --format='%h (%cs)')"
