#!/usr/bin/env python3
"""Fail-closed SSRF and authorization guard for the Chameleon service."""
import asyncio
import importlib.util
import ipaddress
import json
import os
import socket
import time
from pathlib import Path
from typing import Dict, List

SCRIPT = Path(__file__).with_name("mubx-chameleon")
spec = importlib.util.spec_from_file_location("mubx_chameleon_impl", SCRIPT)
if spec is None or spec.loader is None:
    raise RuntimeError(f"unable to load {SCRIPT}")
ch = importlib.util.module_from_spec(spec)
spec.loader.exec_module(ch)

_ORIGINAL_OPEN_CONNECTION = asyncio.open_connection
_VALIDATED: Dict[str, List[str]] = {}


def _user_is_active(user: dict, now: float) -> bool:
    if user.get("status") == "frozen":
        return False
    expiry = str(user.get("expiry") or "").strip().lower()
    if not expiry or expiry == "never":
        return True
    try:
        # mubx-users stores UTC-independent calendar dates. Expiry is inclusive
        # through 23:59:59 of that date, matching the Go auth store semantics.
        import datetime
        end = datetime.datetime.strptime(expiry, "%Y-%m-%d").replace(tzinfo=datetime.timezone.utc)
        return now < end.timestamp() + 86400
    except ValueError:
        return False


def _load_authorized_tokens():
    path = os.environ.get("MUBX_USERS_FILE", "/etc/mubx/users.json")
    tokens = set()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        users = data if isinstance(data, list) else data.get("users", [])
        now = time.time()
        for user in users:
            if isinstance(user, dict) and _user_is_active(user, now):
                token = user.get("uuid") or user.get("token") or user.get("id")
                if token:
                    tokens.add(str(token))
    except Exception:
        return set()
    return tokens


def _load_authorized_users(force_refresh=False):
    path = os.environ.get("MUBX_USERS_FILE", "/etc/mubx/users.json")
    users = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        entries = data if isinstance(data, list) else data.get("users", [])
        now = time.time()
        for user in entries:
            if isinstance(user, dict) and _user_is_active(user, now):
                name = user.get("name")
                token = user.get("uuid") or user.get("token")
                if name and token:
                    users[str(name)] = str(token)
    except Exception:
        return {}
    return users

# Replace the legacy Chameleon authorization loaders so expiry and malformed
# expiry values fail closed immediately, without waiting for the quota timer.
ch.load_auth_tokens = _load_authorized_tokens
ch.load_valid_users = _load_authorized_users


async def _resolve_global(host: str) -> List[str]:
    loop = asyncio.get_running_loop()
    infos = await asyncio.wait_for(loop.getaddrinfo(host, None, family=socket.AF_UNSPEC, type=socket.SOCK_STREAM), timeout=2.0)
    ips: List[str] = []
    for info in infos:
        ip = ipaddress.ip_address(info[4][0])
        if not ip.is_global:
            raise OSError(f"SSRF target rejected: {ip}")
        if str(ip) not in ips:
            ips.append(str(ip))
    if not ips:
        raise OSError("SSRF target has no DNS answers")
    return ips


async def is_safe_external_target(host: str) -> bool:
    try:
        try:
            ip = ipaddress.ip_address(host)
            if not ip.is_global:
                return False
            _VALIDATED[host] = [str(ip)]
            return True
        except ValueError:
            pass
        ips = await _resolve_global(host)
        _VALIDATED[host.lower().rstrip(".")] = ips
        return True
    except Exception:
        _VALIDATED.pop(host.lower().rstrip("."), None)
        return False


async def guarded_open_connection(host=None, port=None, *args, **kwargs):
    if host is None:
        return await _ORIGINAL_OPEN_CONNECTION(host, port, *args, **kwargs)
    try:
        ipaddress.ip_address(host)
        return await _ORIGINAL_OPEN_CONNECTION(host, port, *args, **kwargs)
    except ValueError:
        pass
    key = str(host).lower().rstrip(".")
    ips = _VALIDATED.pop(key, None)
    if not ips:
        raise OSError("SSRF guard: hostname was not validated")
    last_error = None
    for ip in ips:
        try:
            return await _ORIGINAL_OPEN_CONNECTION(ip, port, *args, **kwargs)
        except OSError as exc:
            last_error = exc
    if last_error is not None:
        raise last_error
    raise OSError("SSRF guard: no validated address connected")


ch.is_safe_external_target = is_safe_external_target
asyncio.open_connection = guarded_open_connection

if __name__ == "__main__":
    asyncio.run(ch.main())
