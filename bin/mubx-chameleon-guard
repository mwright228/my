#!/usr/bin/env python3
"""Fail-closed SSRF guard for the Chameleon service.

The main Chameleon implementation is intentionally left intact; this small
launcher replaces its external-target validator before main() starts. This
keeps the security policy independently testable and avoids a risky rewrite
of the large protocol engine.
"""
import asyncio
import importlib.util
import ipaddress
import socket
from pathlib import Path

SCRIPT = Path(__file__).with_name("mubx-chameleon")
spec = importlib.util.spec_from_file_location("mubx_chameleon_impl", SCRIPT)
if spec is None or spec.loader is None:
    raise RuntimeError(f"unable to load {SCRIPT}")
ch = importlib.util.module_from_spec(spec)
spec.loader.exec_module(ch)


async def is_safe_external_target(host: str) -> bool:
    """Allow only globally routable destinations; DNS failures fail closed."""
    try:
        loop = asyncio.get_running_loop()
        infos = await asyncio.wait_for(
            loop.getaddrinfo(
                host,
                None,
                family=socket.AF_UNSPEC,
                type=socket.SOCK_STREAM,
            ),
            timeout=2.0,
        )
        if not infos:
            return False
        for info in infos:
            ip = ipaddress.ip_address(info[4][0])
            if not ip.is_global:
                return False
        return True
    except Exception:
        return False


ch.is_safe_external_target = is_safe_external_target

if __name__ == "__main__":
    asyncio.run(ch.main())
