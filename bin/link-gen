#!/usr/bin/env bash
# Usage: link-gen [bug-host] [user]
#   bug-host defaults to the server domain; user defaults to 'admin' (the
#   legacy shared identity). With a user store, pass any user name to print
#   that user's links (per-user UUIDs on every transport).
source /usr/local/lib/mubx/common.sh
load_mubx_env
BUG="${1:-$DOMAIN}"
USER_NAME="${2:-admin}"
# Resolve the per-user UUID when a store exists.
if [ -f /etc/mubx/users.json ]; then
  user_uuid="$(jq -r --arg n "$USER_NAME" '.[] | select(.name == $n) | .uuid' \
    /etc/mubx/users.json 2>/dev/null || true)"
  if [ -z "$user_uuid" ]; then
    echo "[!] No MUB-X user named '$USER_NAME'. Users:" >&2
    jq -r '.[].name' /etc/mubx/users.json 2>/dev/null | sed 's/^/  /' >&2 || true
    exit 1
  fi
  UUID="$user_uuid"
else
  [ "$USER_NAME" = "admin" ] || {
    echo "[!] No user store yet; only 'admin' (the shared identity) exists." >&2
    exit 1
  }
fi
MYIP=$(curl -4 -s --max-time 5 ifconfig.me 2>/dev/null || echo "$DOMAIN")
HY2_PASS="${HY2_PASS:?Missing Hysteria password; rerun the installer}"
[ -n "${UUID:-}" ] || { echo "[!] Missing UUID; rerun the installer." >&2; exit 1; }

mubx_clear
printf '%sMUB-X%s · client links\n' "$C_BOLD" "$C_RESET"
mubx_rule
mubx_kv "Gateway"    "$DOMAIN"
mubx_kv "Public IPv4" "$MYIP"
mubx_kv "Bug host"   "$BUG"
mubx_kv "Identity"   "$USER_NAME"
mubx_rule

url() { printf '  %s%s%s\n' "$C_CYAN" "$1" "$C_RESET"; }
kv()  { printf '  %s%-12s%s %s\n' "$C_DIM" "$1:" "$C_RESET" "$2"; }

# --- 1. Hysteria 2 --------------------------------------------------------
mubx_title "[1] Hysteria 2  (UDP 4433)"
url "hysteria2://${HY2_PASS}@${DOMAIN}:4433/?sni=${DOMAIN}&insecure=1#MUBX-Hysteria2"

# --- 2. ZivPN -------------------------------------------------------------
if command -v zivpn >/dev/null 2>&1 && [ -n "${ZIVPN_PASS:-}" ]; then
  mubx_title "[2] ZivPN UDP VPN  (UDP 5667)"
  kv "Host / IP" "$DOMAIN ($MYIP)"
  kv "Password"  "$ZIVPN_PASS"
fi

# --- 3. Xray transports ---------------------------------------------------
mubx_title "[3] Xray transports  (TCP 443)"
printf '  %sVLESS-WS%s\n' "$C_BOLD" "$C_RESET"
url "vless://${UUID}@${BUG}:443?encryption=none&security=tls&type=ws&host=${DOMAIN}&sni=${BUG}&path=%2Fvless-ws#MUBX-VLESS-WS"
printf '  %sVLESS-WS (non-TLS, port 80)%s\n' "$C_BOLD" "$C_RESET"
url "vless://${UUID}@${BUG}:80?encryption=none&security=none&type=ws&host=${DOMAIN}&path=%2Fvless-ws#MUBX-VLESS-WS-80"
printf '  %sVLESS-Reality (Vision) - one link per SNI front:%s\n' "$C_BOLD" "$C_RESET"
for _front in ${REALITY_FRONTS:-www.apple.com}; do
  [ -n "$_front" ] || continue
  url "vless://${UUID}@${DOMAIN}:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${_front}&pbk=${REALITY_PUBKEY}&sid=${SHORT_ID}&spx=%2F&type=tcp#MUBX-Reality-${_front}"
done
printf '  %sVMess-WS%s\n' "$C_BOLD" "$C_RESET"
VJ="{\"v\":\"2\",\"ps\":\"MUBX-VMess\",\"add\":\"${BUG}\",\"port\":\"443\",\"id\":\"${UUID}\",\"aid\":\"0\",\"net\":\"ws\",\"path\":\"/vmess-ws\",\"type\":\"none\",\"host\":\"${DOMAIN}\",\"tls\":\"tls\",\"sni\":\"${BUG}\"}"
url "vmess://$(echo -n "$VJ" | base64 -w 0)"
printf '  %sTrojan-WS%s\n' "$C_BOLD" "$C_RESET"
url "trojan://${UUID}@${BUG}:443?security=tls&type=ws&host=${DOMAIN}&sni=${BUG}&path=%2Ftrojan-ws#MUBX-Trojan"

# --- 4. SSH & injectors ---------------------------------------------------
mubx_title "[4] SSH & injector payloads"
kv "Dropbear SSH"     "$MYIP:2222 (UDPGW 7300)"
kv "SSH alternate"    "$MYIP:109"
printf '  %sSSH over WebSocket%s\n' "$C_BOLD" "$C_RESET"
url "ssh -o ProxyCommand='wstunnel client -L stdio://%h:%p wss://${DOMAIN}${SSH_WS_PATH}' user@${DOMAIN}"
url "ssh -o ProxyCommand='wstunnel client -L stdio://%h:%p ws://${DOMAIN}${SSH_WS_PATH}' user@${DOMAIN}"
kv "Squid HTTP proxy" "$MYIP:8080 or 3128"
printf '  %sPayload:%s  CONNECT [host_port] HTTP/1.1[crlf]Host: %s[crlf]Connection: Keep-Alive[crlf][crlf]\n' \
  "$C_BOLD" "$C_RESET" "$BUG"

# --- 5. WireGuard ---------------------------------------------------------
mubx_title "[5] WireGuard  (UDP 51820)"
WG_CONF=/etc/wireguard/mubx-client.conf
if [ -f "$WG_CONF" ]; then
  printf '  %s●%s Client profile found; scan the QR code:\n' "$C_GREEN" "$C_RESET"
  qrencode -t ansiutf8 < "$WG_CONF"
elif systemctl is-active --quiet wg-quick@wg0 2>/dev/null; then
  printf '  %s●%s WireGuard active on 51820. Profile: %s\n' "$C_GREEN" "$C_RESET" "$WG_CONF"
else
  printf '  %s○%s WireGuard installed but inactive (systemctl status wg-quick@wg0)\n' "$C_RED" "$C_RESET"
fi

# --- 6. OpenVPN -----------------------------------------------------------
mubx_title "[6] OpenVPN profiles"
kv "TCP (1194)" "/etc/openvpn/client/mubx-client-tcp.ovpn"
kv "UDP (2200)" "/etc/openvpn/client/mubx-client-udp.ovpn"

# --- 7. SlowDNS / DNSTT ---------------------------------------------------
mubx_title "[7] SlowDNS / DNSTT  (UDP 53)"
DNSTT_PUB=$(cat /etc/dnstt/dnstt.pub 2>/dev/null || echo "NOT_FOUND")
kv "NS domain" "dns.$DOMAIN"
kv "Pubkey"    "$DNSTT_PUB"
printf '  %sClient:%s\n' "$C_BOLD" "$C_RESET"
url "dnstt-client -udp 1.1.1.1:53 -pubkey ${DNSTT_PUB} dns.${DOMAIN} 127.0.0.1:2222"

mubx_rule
