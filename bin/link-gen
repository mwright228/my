#!/usr/bin/env bash
# Usage: link-gen [bug-host] [user]
#   bug-host defaults to the server domain; user defaults to 'admin' (the
#   legacy shared identity). With a user store, pass any user name to print
#   that user's links (per-user UUIDs on every transport).
#
# Output is drawn as one bordered card per protocol (same 58-column frame
# as the control menu): card header carries the service title + live status
# on the right, and every copyable value is printed below its card as a
# single full-width line so links survive terminal soft-wrapping.
source /usr/local/lib/mubx/common.sh
load_mubx_env
BUG="${1:-$DOMAIN}"
USER_NAME="${2:-admin}"
# Resolve the per-user UUID when a store exists.
if [ -f /etc/mubx/users.json ]; then
  user_uuid="$(jq -r --arg n "$USER_NAME" '.[] | select(.name == $n) | .uuid' \
    /etc/mubx/users.json 2>/dev/null || true)"
  if [ -z "$user_uuid" ]; then
    echo "[!] No MUB-X user named '$USER_NAME'. Users:" >&2
    jq -r '.[].name' /etc/mubx/users.json 2>/dev/null | sed 's/^/  /' >&2 || true
    exit 1
  fi
  UUID="$user_uuid"
else
  [ "$USER_NAME" = "admin" ] || {
    echo "[!] No user store yet; only 'admin' (the shared identity) exists." >&2
    exit 1
  }
fi
MYIP=$(curl -4 -s --max-time 5 ifconfig.me 2>/dev/null || echo "$DOMAIN")
HY2_PASS="${HY2_PASS:?Missing Hysteria password; rerun the installer}"
[ -n "${UUID:-}" ] || { echo "[!] Missing UUID; rerun the installer." >&2; exit 1; }

# --- presentation helpers -------------------------------------------------
# (mubx_box_line / mubx_put / mubx_card / mubx_kvrow live in common.sh)
# One protocol card: unit (or space separated units, all must be active),
# title, meta text; status dot + word flush right.
card() {
  local units="$1" title="$2" meta="$3" left right col word up=1 u
  for u in $units; do
    systemctl is-active --quiet "$u" 2>/dev/null || up=0
  done
  left="$(printf '  %s%s%s' "$C_BOLD" "$title" "$C_RESET")"
  [ -n "$meta" ] && left="$left $(printf '%s%s%s' "$C_DIM" "$meta" "$C_RESET")"
  if [ "$up" -eq 1 ]; then
    col="$C_GREEN"; word='up  '; dot='●'
  else
    col="$C_RED"; word='down'; dot='○'
  fi
  right="$(printf '%s%s%s  %s%s%s' "$col" "$dot" "$C_RESET" "$col" "$word" "$C_RESET")"
  mubx_box_line '┌' '┐'
  mubx_card "$left" "$right"
  mubx_box_line '└' '┘'
}
sub()   { printf '\n  %s%s%s\n' "$C_BOLD" "$1" "$C_RESET"; }
block() { printf '  %s%s%s\n' "$C_CYAN" "$1" "$C_RESET"; }
note()  { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_RESET"; }

mubx_clear
# --- summary box ----------------------------------------------------------
mubx_box_line '┌' '┐'
mubx_put "$(printf '  %sMUB-X%s · %sclient links%s' "$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET")"
mubx_box_line '├' '┤'
mubx_kvrow "Gateway"    "$DOMAIN"
mubx_kvrow "Public IPv4" "$MYIP"
mubx_kvrow "Bug host"   "$BUG"
mubx_kvrow "Identity"   "$USER_NAME"
mubx_box_line '└' '┘'

# A bug host that does not resolve (or resolves elsewhere) silently breaks
# every link that uses it; surface that before anything gets copied out.
if [ "$BUG" != "$DOMAIN" ]; then
  bug_ip="$(getent ahostsv4 "$BUG" 2>/dev/null | awk 'NR==1 { print $1 }')"
  if [ -z "$bug_ip" ]; then
    printf '\n  %s[!]%s "%s" does not resolve - links below using it will not connect.\n' \
      "$C_RED" "$C_RESET" "$BUG"
    printf '  %s    Pass a real bug-host domain, or omit it to default to %s.\n' \
      "$C_RED" "$C_RESET" "$DOMAIN"
  elif printf '%s' "$MYIP" | grep -Eq '^[0-9.]+$' && [ "$bug_ip" != "$MYIP" ]; then
    printf '\n  %s[!]%s "%s" resolves to %s but this server is %s - TLS/WS links\n' \
      "$C_RED" "$C_RESET" "$BUG" "$bug_ip" "$MYIP"
    printf '  %s    will fail unless that address routes to this server.\n' "$C_RED" "$C_RESET"
  fi
fi

# --- 1. Hysteria 2 ---------------------------------------------------------
card hysteria "Hysteria 2" "(UDP 4433)"
sub "Import"
block "hysteria2://${HY2_PASS}@${DOMAIN}:4433/?sni=${DOMAIN}&insecure=1#MUBX-Hysteria2"

# --- 2. ZivPN -------------------------------------------------------------
if command -v zivpn >/dev/null 2>&1 && [ -n "${ZIVPN_PASS:-}" ]; then
  card zivpn "ZivPN UDP VPN" "(UDP 5667)"
  sub "Server"
  block "${DOMAIN} (${MYIP})"
  sub "Password"
  block "$ZIVPN_PASS"
fi

# --- 3. Xray transports ---------------------------------------------------
card xray "Xray transports" "(TCP 80 / 443)"
sub "VLESS WebSocket (TLS)"
block "vless://${UUID}@${BUG}:443?encryption=none&security=tls&type=ws&host=${DOMAIN}&sni=${BUG}&path=%2Fvless-ws#MUBX-VLESS-WS"
sub "VLESS WebSocket (plain, port 80)"
block "vless://${UUID}@${BUG}:80?encryption=none&security=none&type=ws&host=${DOMAIN}&path=%2Fvless-ws#MUBX-VLESS-WS-80"
sub "VLESS HTTPUpgrade"
block "vless://${UUID}@${BUG}:443?encryption=none&security=tls&type=httpupgrade&host=${DOMAIN}&sni=${BUG}&path=%2Fvless-httpupgrade#MUBX-HTTPUpgrade"
sub "VLESS xHTTP"
block "vless://${UUID}@${BUG}:443?encryption=none&security=tls&type=xhttp&host=${DOMAIN}&sni=${BUG}&path=%2Fvless-xhttp#MUBX-XHTTP"
sub "VLESS Reality (Vision) - one link per SNI front"
for _front in ${REALITY_FRONTS:-www.apple.com}; do
  [ -n "$_front" ] || continue
  block "vless://${UUID}@${DOMAIN}:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${_front}&pbk=${REALITY_PUBKEY}&sid=${SHORT_ID}&spx=%2F&type=tcp#MUBX-Reality-${_front}"
done
sub "VMess WebSocket"
VJ="{\"v\":\"2\",\"ps\":\"MUBX-VMess\",\"add\":\"${BUG}\",\"port\":\"443\",\"id\":\"${UUID}\",\"aid\":\"0\",\"net\":\"ws\",\"path\":\"/vmess-ws\",\"type\":\"none\",\"host\":\"${DOMAIN}\",\"tls\":\"tls\",\"sni\":\"${BUG}\"}"
block "vmess://$(echo -n "$VJ" | base64 -w 0)"
sub "Trojan WebSocket"
block "trojan://${UUID}@${BUG}:443?security=tls&type=ws&host=${DOMAIN}&sni=${BUG}&path=%2Ftrojan-ws#MUBX-Trojan"

# --- 4. SSH & injectors ---------------------------------------------------
card dropbear "Dropbear SSH" "(2222 / 109)"
sub "Direct"
block "${MYIP}:2222"
note "  alternate port: ${MYIP}:109"
card wstunnel "SSH over WebSocket" "(80 / 443)"
sub "TLS (wss)"
block "ssh -o ProxyCommand='wstunnel client -L stdio://%h:%p wss://${DOMAIN}${SSH_WS_PATH}' user@${DOMAIN}"
sub "Plain (ws)"
block "ssh -o ProxyCommand='wstunnel client -L stdio://%h:%p ws://${DOMAIN}${SSH_WS_PATH}' user@${DOMAIN}"
card squid "Squid CONNECT proxy" "(8080 / 3128)"
sub "Proxy"
block "${MYIP}:8080  (alt ${MYIP}:3128)"
sub "HTTP payload"
block "CONNECT [host_port] HTTP/1.1[crlf]Host: ${BUG}[crlf]Connection: Keep-Alive[crlf][crlf]"

# --- 5. WireGuard ---------------------------------------------------------
card wg-quick@wg0 "WireGuard" "(UDP 51820)"
WG_CONF=/etc/wireguard/mubx-client.conf
if [ -f "$WG_CONF" ]; then
  sub "Scan the QR code"
  qrencode -t ansiutf8 < "$WG_CONF"
elif systemctl is-active --quiet wg-quick@wg0 2>/dev/null; then
  note "  WireGuard active on 51820. Profile: $WG_CONF"
else
  note "  WireGuard installed but inactive (systemctl status wg-quick@wg0)"
fi

# --- 6. OpenVPN -----------------------------------------------------------
card "openvpn-server@tcp openvpn-server@udp" "OpenVPN" "(TCP 1194 / UDP 2200)"
sub "TCP profile"
block "/etc/openvpn/client/mubx-client-tcp.ovpn"
sub "UDP profile"
block "/etc/openvpn/client/mubx-client-udp.ovpn"

# --- 7. SlowDNS / DNSTT ---------------------------------------------------
card dnstt "SlowDNS / DNSTT" "(UDP 53)"
DNSTT_PUB=$(cat /etc/dnstt/dnstt.pub 2>/dev/null || echo "NOT_FOUND")
sub "NS domain"
block "dns.$DOMAIN"
sub "Public key"
block "$DNSTT_PUB"
sub "Client"
block "dnstt-client -udp 1.1.1.1:53 -pubkey ${DNSTT_PUB} dns.${DOMAIN} 127.0.0.1:2222"
# The server can run perfectly while the registrar never delegated the
# dns.<domain> zone - check so operators are not left chasing nothing.
if command -v dig >/dev/null 2>&1 && [ "$DNSTT_PUB" != "NOT_FOUND" ]; then
  delegation="$(timeout 5 dig +short NS "dns.$DOMAIN" @1.1.1.1 2>/dev/null | head -n 1 || true)"
  if [ -z "$delegation" ]; then
    printf '\n  %s[!]%s No NS delegation found for dns.%s - resolvers will never\n' \
      "$C_YELLOW" "$C_RESET" "$DOMAIN"
    printf '  %s    reach this server. Add an NS record (e.g. ns1.%s) with a\n' \
      "$C_YELLOW" "$C_RESET" "$DOMAIN"
    printf '  %s    glue A record pointing at %s in your DNS panel.\n' \
      "$C_YELLOW" "$C_RESET" "$MYIP"
  fi
fi

# --- 8. Shadowsocks -------------------------------------------------------
card xray "Shadowsocks WS" "(WebSocket, per user)"
SS_UI="$(printf 'aes-256-gcm:%s' "$UUID" | base64 -w 0 | tr '+/' '-_' | tr -d '=')"
sub "TLS route (port 443)"
block "ss://${SS_UI}@${BUG}:443?plugin=v2ray-plugin%3Btls%3Bhost%3D${BUG}%3Bpath%3D%2Fss-${USER_NAME}%3Bmux%3D0#MUBX-SS-${USER_NAME}"
sub "Plain WS route (port 80)"
block "ss://${SS_UI}@${BUG}:80?plugin=v2ray-plugin%3Bhost%3D${BUG}%3Bpath%3D%2Fss-${USER_NAME}%3Bmux%3D0#MUBX-SS-${USER_NAME}"
[ "$BUG" = "$DOMAIN" ] || \
  printf '  %s[!]%s The TLS link above needs SNI %s to terminate on this server - if %s is a configured Reality front, use the plain WS link or the default domain.\n' \
    "$C_RED" "$C_RESET" "$BUG" "$BUG"
printf '\n'
