#!/usr/bin/env bash
# MUB-X control panel.
if [ ! -f /etc/telecom-engine.env ]; then
  echo "[!] Run install.sh first"; exit 1
fi
source /usr/local/lib/mubx/common.sh

DOMAIN=
load_mubx_env 2>/dev/null || true

# ---- presentation ---------------------------------------------------
# Bordered-panel drawing (mubx_box_line / mubx_put / mubx_card) lives in
# lib/common.sh so every screen shares the same 58-column frame.

# Two service entries per row, right column aligned.
row() { # $1 unit1 $2 label1 $3 unit2 $4 label2
  mubx_put "$(printf '  %s %-14s  %s %s' "$(svc_dot "$1")" "$2" "$(svc_dot "$3")" "$4")"
}

# Status for a set of templated units (the badvpn@7100..7700 instances):
# green ● when all are active, yellow ◐ when some are, red ○ when none are.
# Callers pass the exact instance list so we never probe empty ports.
svc_dot_set() { # $1 unit name  remaining args: instance ports to check
  local unit="$1" port up=0 down=0
  shift
  for port in "$@"; do
    if systemctl is-active --quiet "$unit@$port" 2>/dev/null; then
      up=$((up + 1))
    else
      down=$((down + 1))
    fi
  done
  if [ "$down" -eq 0 ]; then
    printf '%s●%s' "$C_GREEN" "$C_RESET"
  elif [ "$up" -eq 0 ]; then
    printf '%s○%s' "$C_RED" "$C_RESET"
  else
    printf '%s◐%s' "$C_YELLOW" "$C_RESET"
  fi
}

draw() {
  mubx_clear
  mubx_box_line '┌' '┐'
  mubx_put "$(printf '  %sMUB-X%s · %s%s%s' "$C_BOLD" "$C_RESET" "$C_CYAN" "${DOMAIN:-UNCONFIGURED}" "$C_RESET")"
  mubx_put "$(printf '  %s%s%s' "$C_DIM" "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$C_RESET")"
  mubx_box_line '├' '┤'
  mubx_put ''
  mubx_put "$(printf '  %sServices%s' "$C_BOLD" "$C_RESET")"
  row haproxy    "HAProxy"       nginx                "Nginx"
  row xray       "Xray"          dropbear             "Dropbear"
  row wstunnel   "SSH over WS"   squid                "Squid proxy"
  row hysteria   "Hysteria 2"    wg-quick@wg0         "WireGuard"
  row openvpn-server@tcp "OpenVPN TCP" openvpn-server@udp "OpenVPN UDP"
  mubx_put "$(printf '  %s %s' "$(svc_dot zivpn)" "ZivPN")"
  mubx_put "$(printf '  %s %s' \
    "$(svc_dot_set badvpn 7100 7200 7300 7400 7500 7600 7700)" "UDPGW bridge (7100-7700)")"
  mubx_put "$(printf '  %s●%s all up   %s◐%s partial   %s○%s down' \
    "$C_GREEN" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_RED" "$C_RESET")"
  mubx_put ''
  mubx_put "$(printf '  %sCommands%s' "$C_BOLD" "$C_RESET")"
  opt() { # $1 number $2 description
    mubx_put "$(printf '  %s%-2s%s   %s' "$C_CYAN" "$1" "$C_RESET" "$2")"
  }
  opt 1  "Set domain / renew certificate"
  opt 2  "Generate client links"
  opt 3  "Show OpenVPN client profile"
  opt 4  "Add SSH user"
  opt 5  "Delete SSH user"
  opt 6  "Restart services"
  opt 7  "Service status (all protocols)"
  opt 8  "Run network diagnostics"
  opt 9  "Show transport recommendation"
  opt 10 "Users & traffic"
  opt 11 "Bug-host audit"
  opt 12 "Restart failed services"
  opt 13 "Update MUB-X (git pull + re-render)"
  opt 0  "Exit"
  mubx_put ''
  mubx_box_line '└' '┘'
}

while true; do
  draw
  read -r -p "  Choose: " opt || exit 0
  case "$opt" in
    1) /usr/local/bin/set-domain ;;
    2) read -r -p "  Bug-host [${DOMAIN:-}]: " b
       read -r -p "  User [admin]: " mu
       /usr/local/bin/link-gen "${b:-$DOMAIN}" "${mu:-admin}" ;;
    3) cat /etc/openvpn/client/mubx-client-tcp.ovpn 2>/dev/null || echo "OpenVPN client config not found" ;;
    4) /usr/local/bin/add-user ;;
    5) /usr/local/bin/delete-user ;;
    6) systemctl restart haproxy nginx xray dropbear squid wstunnel hysteria \
         zivpn wg-quick@wg0 openvpn-server@tcp openvpn-server@udp \
         badvpn@7100 badvpn@7200 badvpn@7300 badvpn@7400 \
         badvpn@7500 badvpn@7600 badvpn@7700 2>/dev/null || true
       echo "  [*] Core services restarted" ;;
    7) /usr/local/bin/svc-status ;;
    8) /usr/local/bin/mubx-diagnose ;;
    9) cat /var/lib/mubx/adaptive-recommendation 2>/dev/null || echo "No recommendation yet" ;;
    10) /usr/local/bin/mubx-users ;;
    11) /usr/local/bin/mubx-probe ;;
    12) /usr/local/bin/mubx-restart-failed ;;
    13) /usr/local/bin/mubx-update ;;
    0|q|Q) exit 0 ;;
    *) echo "  Invalid choice: $opt"; sleep 1; continue ;;
  esac
  # Pause so the output of the chosen command stays readable. Reads from
  # stdin like every other prompt in this menu: /dev/tty is not guaranteed
  # to be interactive in every terminal, and a hung read would leave the
  # panel frozen after a command finishes.
  if [ -t 0 ]; then
    read -r -p "  Press Enter to return to the menu... " _ || true
  fi
done
