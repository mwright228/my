#!/usr/bin/env bash
# MUB-X control panel.
if [ ! -f /etc/telecom-engine.env ]; then
  echo "[!] Run install.sh first"; exit 1
fi
source /usr/local/lib/mubx/common.sh

DOMAIN=
load_mubx_env 2>/dev/null || true

# Two service entries per row.
row() { # $1 unit1 $2 label1 $3 unit2 $4 label2
  printf '  %s %-16s %s %s\n' "$(svc_dot "$1")" "$2" "$(svc_dot "$3")" "$4"
}

draw() {
  mubx_clear
  printf '%sMUB-X%s  %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_CYAN" "${DOMAIN:-UNCONFIGURED}" "$C_RESET"
  mubx_rule
  printf '  %s%s%s\n' "$C_DIM" "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$C_RESET"
  printf '\n'

  printf '\n%sServices%s\n' "$C_BOLD" "$C_RESET"
  row haproxy    "HAProxy"       nginx                "Nginx"
  row xray       "Xray"          dropbear             "Dropbear"
  row wstunnel   "SSH over WS"   squid                "Squid proxy"
  row hysteria   "Hysteria 2"    wg-quick@wg0         "WireGuard"
  row openvpn-server@tcp "OpenVPN TCP" openvpn-server@udp "OpenVPN UDP"
  row dnstt      "DNSTT"         zivpn                "ZivPN"
  printf '  %s %s\n' "$(svc_dot badvpn@7100)" "UDPGW bridge (7100-7700)"
  printf '  %s●%s active    %s○%s inactive\n' "$C_GREEN" "$C_RESET" "$C_RED" "$C_RESET"
  printf '\n'

  printf '%sCommands%s\n' "$C_BOLD" "$C_RESET"
  printf '  %s1%s  Set domain / renew certificate\n'   "$C_CYAN" "$C_RESET"
  printf '  %s2%s  Generate client links\n'             "$C_CYAN" "$C_RESET"
  printf '  %s3%s  Show OpenVPN client profile\n'       "$C_CYAN" "$C_RESET"
  printf '  %s4%s  Add SSH user\n'                      "$C_CYAN" "$C_RESET"
  printf '  %s5%s  Delete SSH user\n'                   "$C_CYAN" "$C_RESET"
  printf '  %s6%s  Restart services\n'                  "$C_CYAN" "$C_RESET"
  printf '  %s7%s  Show listening ports\n'              "$C_CYAN" "$C_RESET"
  printf '  %s8%s  Run network diagnostics\n'           "$C_CYAN" "$C_RESET"
  printf '  %s9%s  Show transport recommendation\n'     "$C_CYAN" "$C_RESET"
  printf '  %s10%s Reality SNI fronts\n'                "$C_CYAN" "$C_RESET"
  printf '  %s0%s  Exit\n'                              "$C_CYAN" "$C_RESET"
  mubx_rule
}

while true; do
  draw
  read -r -p "  Choose: " opt || exit 0
  case "$opt" in
    1) /usr/local/bin/set-domain ;;
    2) read -r -p "  Bug-host [${DOMAIN:-}]: " b; /usr/local/bin/link-gen "${b:-$DOMAIN}" ;;
    3) cat /etc/openvpn/client/mubx-client-tcp.ovpn 2>/dev/null || echo "OpenVPN client config not found" ;;
    4) /usr/local/bin/add-user ;;
    5) /usr/local/bin/delete-user ;;
    6) systemctl restart haproxy nginx xray dropbear squid wstunnel hysteria dnstt \
         zivpn wg-quick@wg0 openvpn-server@tcp openvpn-server@udp \
         badvpn@7100 badvpn@7200 badvpn@7300 badvpn@7400 \
         badvpn@7500 badvpn@7600 badvpn@7700 2>/dev/null || true
       echo "[*] Core services restarted" ;;
    7) ss -tulnp | grep -E ':(443|80|2222|8080|3128|10001|10443)' ;;
    8) /usr/local/bin/mubx-diagnose ;;
    9) cat /var/lib/mubx/adaptive-recommendation 2>/dev/null || echo "No recommendation yet" ;;
    10) /usr/local/bin/reality-fronts ;;
    0|q|Q) exit 0 ;;
    *) echo "  Invalid choice: $opt"; sleep 1; continue ;;
  esac
  # Pause so the output of the chosen command stays readable.
  if [ -t 0 ]; then
    read -r -p "  Press Enter to return to the menu... " _ </dev/tty || true
  fi
done
