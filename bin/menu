#!/usr/bin/env bash
if [ ! -f /etc/telecom-engine.env ]; then
  echo "[!] Run install.sh first"; exit 1; fi
source /usr/local/lib/mubx/common.sh
load_mubx_env || DOMAIN="UNCONFIGURED"
STATUS_FLAG() { systemctl is-active --quiet "$1" 2>/dev/null && echo "[ONLINE]" || echo "[OFFLINE]"; }
clear
echo "  MUB-X NODE: $DOMAIN"
echo "  HAProxy: $(STATUS_FLAG haproxy) | Nginx: $(STATUS_FLAG nginx)"
echo "  Xray: $(STATUS_FLAG xray) | Dropbear: $(STATUS_FLAG dropbear)"
echo "  Squid: $(STATUS_FLAG squid)"
echo ""
echo "  [1] Set Domain / SSL"
echo "  [2] Generate Links"
echo "  [4] Add User"
echo "  [5] Delete User"
echo "  [6] Restart Services"
echo "  [7] Show Ports"
echo "  [8] Network Diagnostics"
echo "  [9] Adaptive Recommendation"
echo "  [0] Exit"
read -p "Select: " opt
case $opt in
  1) /usr/local/bin/set-domain ;;
  2) read -p "Bug-host: " b; /usr/local/bin/link-gen "${b:-$DOMAIN}" ;;
  4) /usr/local/bin/add-user ;;
  5) /usr/local/bin/delete-user ;;
  6) systemctl restart haproxy nginx xray dropbear squid; echo "[*] Restarted" ;;
  7) ss -tulnp | grep -E ':(443|80|2222|8080|3128|10001|10443)' ;;
  8) /usr/local/bin/mubx-diagnose ;;
  9) cat /var/lib/mubx/adaptive-recommendation 2>/dev/null || echo "No recommendation yet" ;;
  0) exit 0 ;; esac
