#!/usr/bin/env bash
if [ ! -f /etc/telecom-engine.env ]; then
  echo "[!] Run install.sh first"; exit 1; fi
source /usr/local/lib/mubx/common.sh
load_mubx_env || DOMAIN="UNCONFIGURED"
if [ -t 1 ]; then
  C_RESET=$'\033[0m'
  C_BLUE=$'\033[38;5;75m'
  C_CYAN=$'\033[38;5;81m'
  C_GREEN=$'\033[38;5;78m'
  C_RED=$'\033[38;5;203m'
  C_DIM=$'\033[38;5;245m'
  C_BOLD=$'\033[1m'
else
  C_RESET= C_BLUE= C_CYAN= C_GREEN= C_RED= C_DIM= C_BOLD=
fi
STATUS_FLAG() {
  if systemctl is-active --quiet "$1" 2>/dev/null; then
    printf '%s%s● ONLINE%s' "$C_GREEN" "$C_BOLD" "$C_RESET"
  else
    printf '%s%s● OFFLINE%s' "$C_RED" "$C_BOLD" "$C_RESET"
  fi
}
clear
printf '%s%sMUB-X SERVER MENU%s\n' "$C_BOLD" "$C_BLUE" "$C_RESET"
printf '%s%s%s\n' "$C_DIM" "----------------------------------------" "$C_RESET"
printf '  Host: %s%s%s\n' "$C_CYAN" "$DOMAIN" "$C_RESET"
printf '  Time: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"

printf '%sServices%s\n' "$C_BOLD" "$C_RESET"
printf '  HAProxy   %-18b  Nginx     %b\n' "$(STATUS_FLAG haproxy)" "$(STATUS_FLAG nginx)"
printf '  Xray      %-18b  Dropbear  %b\n' "$(STATUS_FLAG xray)" "$(STATUS_FLAG dropbear)"
printf '  wstunnel  %-18b  Squid     %b\n' "$(STATUS_FLAG wstunnel)" "$(STATUS_FLAG squid)"
printf '  Hysteria  %-18b  WireGuard %b\n\n' "$(STATUS_FLAG hysteria)" "$(STATUS_FLAG wg-quick@wg0)"

printf '%sCommands%s\n' "$C_BOLD" "$C_RESET"
printf '  %s1%s  Set domain and SSL certificate\n' "$C_CYAN" "$C_RESET"
printf '  %s2%s  Generate client links\n' "$C_CYAN" "$C_RESET"
printf '  %s3%s  Show OpenVPN client config\n' "$C_CYAN" "$C_RESET"
printf '  %s4%s  Add user\n' "$C_CYAN" "$C_RESET"
printf '  %s5%s  Delete user\n' "$C_CYAN" "$C_RESET"
printf '  %s6%s  Restart services\n' "$C_CYAN" "$C_RESET"
printf '  %s7%s  Show listening ports\n' "$C_CYAN" "$C_RESET"
printf '  %s8%s  Run network diagnostics\n' "$C_CYAN" "$C_RESET"
printf '  %s9%s  Show transport recommendation\n' "$C_CYAN" "$C_RESET"
printf '  %s0%s  Exit\n\n' "$C_CYAN" "$C_RESET"
read -r -p "Choose an option: " opt
case "$opt" in
  1) /usr/local/bin/set-domain ;;
  2) read -p "Bug-host: " b; /usr/local/bin/link-gen "${b:-$DOMAIN}" ;;
  3) cat /etc/openvpn/client/mubx-client-tcp.ovpn 2>/dev/null || echo "OpenVPN client config not found" ;;
  4) /usr/local/bin/add-user ;;
  5) /usr/local/bin/delete-user ;;
  6) systemctl restart haproxy nginx xray dropbear squid wstunnel; echo "[*] Services restarted" ;;
  7) ss -tulnp | grep -E ':(443|80|2222|8080|3128|10001|10443)' ;;
  8) /usr/local/bin/mubx-diagnose ;;
  9) cat /var/lib/mubx/adaptive-recommendation 2>/dev/null || echo "No recommendation yet" ;;
  0) exit 0 ;; esac
