#!/usr/bin/env bash
# MUB-X service status & transport matrix.
set -Eeuo pipefail

source /usr/local/lib/mubx/common.sh
DOMAIN=
load_mubx_env 2>/dev/null || true

XRAY_CONF=/usr/local/etc/xray/config.json
[ -f "$XRAY_CONF" ] || { echo "[!] Run install.sh first"; exit 1; }

# Verdict check: unit active + socket listening
check() { # $1 unit  $2 protocol(tcp|udp)  $3 port
  local unit="$1" proto="$2" port="${3:-}"
  systemctl is-active --quiet "$unit" 2>/dev/null || return 1
  if [ -n "$port" ]; then
    ss -H -l"${proto:0:1}"n "sport = :$port" 2>/dev/null | grep -q . || return 1
  fi
  return 0
}

# Failure explanation helper
failure_hint() { # $1 unit  $2 protocol(tcp|udp)  $3 port
  local unit="$1" proto="$2" port="${3:-}"
  local msg='' holder last
  if [ -n "$port" ] && ! ss -H -l"${proto:0:1}"n "sport = :$port" 2>/dev/null | grep -q .; then
    holder="$(ss -H -l"${proto:0:1}"n -p "sport = :$port" 2>/dev/null | head -n 1)"
    if [ -n "$holder" ]; then
      msg="port $port held by other process: $holder"
    else
      msg="no ${proto^^}/$port socket listening"
    fi
  fi
  last="$(journalctl -u "$unit" -n 2 --no-pager -o cat 2>/dev/null | tail -n 1 || true)"
  if [ -n "$last" ]; then
    msg="${msg:+$msg; }$last"
  fi
  printf '%s' "$msg"
}

# --- presentation -----------------------------------------------------------
declare -a _hints=()

group_open() { # $1 section title  $2 meta
  _hints=()
  mubx_box_top "$1" "${2:-}"
}

group_close() {
  mubx_box_bot
  local h
  if [ "${#_hints[@]}" -gt 0 ]; then
    for h in "${_hints[@]}"; do
      printf '  %s↳ %s%s\n' "$C_SLATE" "${h:0:96}" "$C_RESET"
    done
    printf '\n'
  fi
}

# One status row
row() { # $1 label  $2 unit  $3 tcp|udp  $4 port
  local label="$1" unit="$2" proto="$3" port="${4:-}" right
  if check "$unit" "$proto" "$port"; then
    right="$(mubx_pill UP "ONLINE")"
  else
    right="$(mubx_pill DOWN "OFFLINE")"
    _hints+=("$(failure_hint "$unit" "$proto" "$port")")
  fi
  mubx_card "  $label" "$right"
}

mubx_clear

# --- Summary Box ------------------------------------------------------------
mubx_box_top "MUB-X SERVICE MATRIX" "TELEMETRY"
mubx_kvrow "Gateway Host" "${DOMAIN:-UNCONFIGURED}"
mubx_kvrow "Uptime"       "$(mubx_sys_uptime)"
mubx_kvrow "System Load"  "$(mubx_sys_cpu)"
mubx_kvrow "RAM Usage"    "$(mubx_sys_ram)"
mubx_kvrow "Timestamp"    "$(date '+%Y-%m-%d %H:%M:%S %Z')"
mubx_box_bot
printf '\n'

# --- Xray Transports --------------------------------------------------------
group_open "XRAY TRANSPORTS" "INGRESS"
while IFS=$'\t' read -r tag proto port; do
  [ -n "$tag" ] || continue
  case "$tag" in
    socks-local|api) continue ;;
    vless-ws)          label="VLESS WebSocket (TLS 443 / 80)" ;;
    vmess-ws)          label="VMess WebSocket (TLS 443 / 80)" ;;
    trojan-ws)         label="Trojan WebSocket (TLS 443 / 80)" ;;
    vless-httpupgrade) label="VLESS HTTPUpgrade" ;;
    vless-xhttp)       label="VLESS xHTTP" ;;
    shadowsocks-*)     name="${tag#shadowsocks-}"
                       label="Shadowsocks WS ($name)" ;;
    ss2022-*)          name="${tag#ss2022-}"
                       label="Shadowsocks 2022 WS ($name)" ;;
    ssplain-*)         name="${tag#ssplain-}"
                       label="Shadowsocks TCP ($name)" ;;
    ss-443)            label="Shadowsocks TCP (443 Primary)" ;;
    *)                 label="${tag}" ;;
  esac
  row "$label" xray tcp "$port"
done < <(jq -r '.inbounds[] | select(.tag != "socks-local" and .tag != "api") | [.tag, (.protocol // "-"), (.port // 0)] | @tsv' "$XRAY_CONF" 2>/dev/null)
group_close

# --- VPN & Stealth Tunnels --------------------------------------------------
group_open "STEALTH & TUNNELS" "CORE"
row "Hysteria 2 (UDP 4433)"      hysteria           udp 4433
if [ -f /etc/systemd/system/singbox.service ] && [ -s /etc/sing-box/config.json ]; then
  row "ShadowTLS v3 + SS-2022"    singbox            tcp 8448
fi
row "ZivPN UDP Tunnel (5667)"    zivpn              udp 5667
row "WireGuard (UDP 51820)"      wg-quick@wg0       udp 51820
row "OpenVPN TCP (1194)"         openvpn-server@tcp tcp 1194
row "OpenVPN UDP (2200)"         openvpn-server@udp udp 2200
row "Dropbear SSH (2222/109/53)" dropbear           tcp 2222
row "wstunnel SSH-over-WS"       wstunnel           tcp 18080
group_close

# --- Ingress & Proxy Layer --------------------------------------------------
group_open "INGRESS & PROXY" "PORTS"
row "HAProxy 443/8443 Demux"          haproxy tcp 443
row "Nginx Web & TLS (20443)"        nginx   tcp 20443
row "Nginx HTTP (80)"                nginx   tcp 80
row "Chameleon Engine (8080/3128)"   mubx-chameleon tcp 8080
row "Squid CONNECT (8080/3128)"      squid   tcp 8080
row "Fail2ban Defense"               fail2ban "" ""
group_close

# --- BadVPN UDPGW -----------------------------------------------------------
group_open "UDPGW GAMING BRIDGES" "PORTS 7100-7700"
for p in 7100 7200 7300 7400 7500 7600 7700; do
  row "BadVPN UDPGW Port $p" "badvpn@$p" tcp "$p"
done
group_close

# --- Maintenance Timers -----------------------------------------------------
group_open "AUTOMATION TIMERS" "CRON"
row "Weekly Maintenance" mubx-cron.timer "" ""
row "Adaptive Optimizer" mubx-adaptive.timer "" ""
group_close

