#!/usr/bin/env bash
# MUB-X service status: one verdict per protocol / transport, not just per
# systemd unit. Xray transports are enumerated from the live config so every
# inbound (incl. each per-user Shadowsocks route and the shared SS-443
# inbound) is listed individually; UDP-only daemons are checked via their
# listener, TCP ones via their unit + socket.
#
# Output uses the same 58-column bordered frame as the menu: one card per
# group, status flush right per row, and any failing service explains itself
# (port conflict / last journal line) in a note right under the card.
set -Eeuo pipefail

source /usr/local/lib/mubx/common.sh
DOMAIN=
load_mubx_env 2>/dev/null || true

XRAY_CONF=/usr/local/etc/xray/config.json
[ -f "$XRAY_CONF" ] || { echo "[!] Run install.sh first"; exit 1; }

# verdict: unit active (and, when given, listener on proto/port)
# returns 0 online, 1 offline; caller formats the text.
check() { # $1 unit  $2 protocol(tcp|udp)  $3 port (empty = unit-only)
  local unit="$1" proto="$2" port="${3:-}"
  systemctl is-active --quiet "$unit" 2>/dev/null || return 1
  if [ -n "$port" ]; then
    ss -H -"${proto}"ln "sport = :$port" 2>/dev/null | grep -q . || return 1
  fi
  return 0
}

# Explain why a service is down: for listener-backed rows, whether
# anything is actually bound to the expected port, plus the last
# journal line from the unit itself.
failure_hint() { # $1 unit  $2 protocol(tcp|udp)  $3 port (empty = unit-only)
  local unit="$1" proto="$2" port="${3:-}"
  local msg='' holder last
  if [ -n "$port" ] && ! ss -H -l"${proto:0:1}"n "sport = :$port" 2>/dev/null | grep -q .; then
    holder="$(ss -H -l"${proto:0:1}"n -p "sport = :$port" 2>/dev/null | head -n 1)"
    if [ -n "$holder" ]; then
      msg="port $port is held by another listener: $holder"
    else
      msg="no ${proto^^}/$port listener"
    fi
  fi
  last="$(journalctl -u "$unit" -n 2 --no-pager -o cat 2>/dev/null | tail -n 1 || true)"
  if [ -n "$last" ]; then
    msg="${msg:+$msg; }$last"
  fi
  printf '%s' "$msg"
}

# --- presentation -----------------------------------------------------------
declare -a _hints=()

group_open() { # $1 section title
  _hints=()
  mubx_box_line '┌' '┐'
  mubx_put "$(printf '  %s%s%s' "$C_BOLD" "$1" "$C_RESET")"
  mubx_box_line '├' '┤'
}

group_close() {
  mubx_box_line '└' '┘'
  local h
  if [ "${#_hints[@]}" -gt 0 ]; then
    for h in "${_hints[@]}"; do
      printf '  %s↳ %s%s\n' "$C_DIM" "${h:0:96}" "$C_RESET"
    done
  fi
  printf '\n'
}

# One status row; a failing service registers its explanation in _hints.
row() { # $1 label  $2 unit  $3 tcp|udp  $4 port
  local label="$1" unit="$2" proto="$3" port="${4:-}" right col
  if check "$unit" "$proto" "$port"; then
    col="$C_GREEN"
    right="$(printf '%s●%s  %s%s%s' "$col" "$C_RESET" "$col" 'up  ' "$C_RESET")"
  else
    col="$C_RED"
    right="$(printf '%s○%s  %s%s%s' "$col" "$C_RESET" "$col" 'down' "$C_RESET")"
    _hints+=("$(failure_hint "$unit" "$proto" "$port")")
  fi
  mubx_card "$(printf '  %s' "$label")" "$right"
}

mubx_clear
# --- summary box ------------------------------------------------------------
mubx_box_line '┌' '┐'
mubx_put "$(printf '  %sMUB-X%s · %sservice information%s' "$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET")"
mubx_box_line '├' '┤'
mubx_kvrow "Domain"    "${DOMAIN:-UNCONFIGURED}"
mubx_kvrow "Timestamp" "$(date '+%Y-%m-%d %H:%M:%S %Z')"
mubx_box_line '└' '┘'
printf '\n'

# --- Xray transports --------------------------------------------------------
group_open "Xray transports"
while IFS=$'\t' read -r tag proto port; do
  [ -n "$tag" ] || continue
  case "$tag" in
    socks-local|api) continue ;;
    vless-ws)      label="VLESS WebSocket (WS)" ;;
    vmess-ws)      label="VMess WebSocket (WS)" ;;
    trojan-ws)     label="Trojan WebSocket (WS)" ;;
    vless-httpupgrade) label="VLESS HTTPUpgrade" ;;
    vless-xhttp)   label="VLESS xHTTP" ;;
    vless-tls-tcp) label="VLESS TCP TLS (8443)" ;;
    shadowsocks-*) name="${tag#shadowsocks-}"
                   label="Shadowsocks WS ($name)" ;;
    ssplain-*)     name="${tag#ssplain-}"
                   label="Shadowsocks TCP ($name)" ;;
    ss-443)        label="Shadowsocks TCP (443 shared)" ;;
    *)             label="${tag}" ;;
  esac
  row "Xray · $label" xray tcp "$port"
done < <(jq -r '.inbounds[] | select(.tag != "socks-local" and .tag != "api") | [.tag, (.protocol // "-"), (.port // 0)] | @tsv' "$XRAY_CONF" 2>/dev/null)
group_close

# --- BadVPN UDPGW -----------------------------------------------------------
group_open "BadVPN UDPGW ports"
for p in 7100 7200 7300 7400 7500 7600 7700; do
  row "BadVPN UDPGW $p" "badvpn@$p" udp "$p"
done
group_close

# --- VPN & tunnel services --------------------------------------------------
group_open "VPN & tunnel services"
row "OpenVPN TCP (1194)"  openvpn-server@tcp tcp 1194
row "OpenVPN UDP (2200)"  openvpn-server@udp udp 2200
row "WireGuard (51820)"   wg-quick@wg0   udp 51820
row "Hysteria 2 (4433)"   hysteria       udp 4433
row "ZivPN UDP VPN (5667)" zivpn         udp 5667
row "Dropbear SSH (109, 2222, 53)" dropbear  tcp 2222
group_close

# --- Web / proxy layer ------------------------------------------------------
group_open "Proxy & web services"
row "HAProxy TLS front (443)" haproxy tcp 443
row "Nginx TLS terminator"    nginx   tcp 443
row "Nginx plain HTTP (80)"   nginx   tcp 80
row "Squid CONNECT proxy (8080, 3128)" squid tcp 8080
row "wstunnel SSH-over-WS"    wstunnel tcp 18080
row "fail2ban (dropbear jail)" fail2ban "" ""
group_close

# --- Maintenance timers -----------------------------------------------------
group_open "Maintenance timers"
row "mubx weekly cron"     mubx-cron.timer "" ""
row "mubx adaptive probe"  mubx-adaptive.timer "" ""
group_close
