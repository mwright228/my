#!/bin/bash
set -Eeuo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Run mubx-tune as root." >&2
  exit 1
fi

install -d -m 0755 /etc/sysctl.d
cat > /etc/sysctl.d/99-mubx-network.conf <<'EOF'
net.ipv4.tcp_keepalive_time=600
net.ipv4.tcp_keepalive_intvl=30
net.ipv4.tcp_keepalive_probes=5
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
EOF
if sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1; then
  echo "Enabled BBR congestion control."
else
  echo "BBR unavailable; retaining the kernel default." >&2
fi
if sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1; then
  echo "Enabled fq queue discipline."
else
  echo "fq unavailable; retaining the kernel default." >&2
fi
sysctl --system >/dev/null
echo "Network tuning applied. Use mubx-diagnose to compare MTU profiles."
