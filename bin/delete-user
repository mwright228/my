#!/usr/bin/env bash
set -Eeuo pipefail
[ "$(id -u)" -eq 0 ] || [ "${MUBX_ALLOW_NON_ROOT:-0}" -eq 1 ] || { echo "[!] Run delete-user as root." >&2; exit 1; }

BASE="$(dirname "${BASH_SOURCE[0]}")/.."
if [ -r /usr/local/lib/mubx/common.sh ]; then source /usr/local/lib/mubx/common.sh; source /usr/local/lib/mubx/render.sh; else source "$BASE/lib/common.sh"; source "$BASE/lib/render.sh"; fi
load_mubx_env 2>/dev/null || true
STORE="${MUBX_USERS_FILE:-/etc/mubx/users.json}"

# Deprovisioning is one transaction: revoke the MUB-X identity first, then remove
# the Linux account. If anything fails, the MUB-X state is restored rather than
# leaving an active proxy identity pointing at a missing Linux account.
if [ -r /usr/local/lib/mubx/mubx-transaction.sh ]; then source /usr/local/lib/mubx/mubx-transaction.sh; else source "$BASE/lib/mubx-transaction.sh"; fi
mubx_tx_begin delete-user
export MUBX_USERS_TX_ACTIVE=1
mubx_tx_snapshot "$STORE"
mubx_tx_snapshot_tree "${MUBX_SUB_DIR:-/var/www/mubx-sub}"
mubx_tx_snapshot_tree "${MUBX_SS2022_DIR:-/etc/mubx/ss2022-keys}"
mubx_tx_snapshot_tree "${MUBX_SUB_TOKEN_DIR:-/etc/mubx/sub-tokens}"
transaction_exit(){ local status=$?; if [ "$status" -eq 0 ]; then mubx_tx_commit; else mubx_tx_abort || true; fi; exit "$status"; }
trap transaction_exit EXIT

mubx_clear
mubx_box_top "USER DEPROVISIONING" "DELETE"
mubx_put "$(printf '  %sSelect an account to revoke from SSH, VPNs, and Xray proxies:%s' "$C_SLATE" "$C_RESET")"
mubx_box_bot
printf '\n'

declare -a user_names=() user_expiries=() user_protos=() user_statuses=()
if [ -f "$STORE" ]; then
  while IFS=$'\t' read -r u exp proto status; do
    [ -n "$u" ] || continue; [ "$u" != admin ] || continue
    user_names+=("$u"); user_expiries+=("${exp:-never}"); user_protos+=("${proto:-ALL}"); user_statuses+=("${status:-active}")
  done < <(jq -r '.[] | select(.name != "admin") | [.name, (.expiry // "never"), ((.protocols // ["all"]) | join(",")), (.status // "active")] | @tsv' "$STORE" 2>/dev/null || true)
fi
while IFS=: read -r lu _ luid _ _ _ lshell; do
  [ -n "$lu" ] && [ "$luid" -ge 1000 ] 2>/dev/null && [ "$lshell" = /bin/false ] && [ "$lu" != nobody ] || continue
  found=0; for u in "${user_names[@]:-}"; do [ "$u" = "$lu" ] && found=1 && break; done
  if [ "$found" -eq 0 ]; then user_names+=("$lu"); user_expiries+=(system); user_protos+=(SSH/Chameleon); user_statuses+=(active); fi
done < <(getent passwd 2>/dev/null || cat /etc/passwd 2>/dev/null || true)

count=${#user_names[@]}
[ "$count" -gt 0 ] || { warn "No user accounts found to delete."; exit 0; }
printf '  %s%-5s %-16s %-14s %-18s %-10s%s\n' "$C_PURPLE" "#" "ACCOUNT" "EXPIRY" "PROTOCOLS" "STATUS" "$C_RESET"
mubx_rule
for ((i=0; i<count; i++)); do
  printf '  %s[%d]%s  %-16s %-14s %-18s %b\n' "$C_ELECTRIC" "$((i+1))" "$C_RESET" "${user_names[$i]}" "${user_expiries[$i]}" "${user_protos[$i]}" "$(mubx_pill "${user_statuses[$i]}")"
done
printf '\n  %sEnter # or Username to delete (0 to cancel): %s' "$C_CORAL" "$C_RESET"; read -r choice
[ -n "$choice" ] && [ "$choice" != 0 ] && [ "$choice" != q ] && [ "$choice" != Q ] || exit 0

target_user=""
if [[ "$choice" =~ ^[0-9]+$ ]]; then idx=$((choice-1)); [ "$idx" -ge 0 ] && [ "$idx" -lt "$count" ] || die "Invalid selection number: $choice"; target_user="${user_names[$idx]}"; else for u in "${user_names[@]}"; do [ "$u" = "$choice" ] && target_user="$u" && break; done; [ -n "$target_user" ] || die "User '$choice' not found in account list"; fi
printf '\n  %sAre you sure you want to permanently delete user "%s%s%s"? [y/N]: %s' "$C_AMBER" "$C_BRIGHT" "$target_user" "$C_AMBER" "$C_RESET"; read -r confirm
[[ "$confirm" =~ ^[yY]([eE][sS])?$ ]] || { echo "[-] Deletion cancelled."; exit 0; }

mubx_users_bin="/usr/local/bin/mubx-users"; [ -x "$mubx_users_bin" ] || mubx_users_bin="$BASE/bin/mubx-users"
[ -x "$mubx_users_bin" ] || die "mubx-users command not found"
[ -f "$STORE" ] || die "MUB-X user store missing at $STORE"

# Revoke the proxy identity while the transaction lock is held. The inherited
# MUBX_USERS_TX_ACTIVE marker prevents a nested lock attempt.
"$mubx_users_bin" remove "$target_user" >/dev/null

# Remove the OS account only after MUB-X revocation succeeded.
if id "$target_user" >/dev/null 2>&1; then
  if ! userdel -r "$target_user" 2>/dev/null && ! userdel "$target_user" 2>/dev/null; then
    echo "[!] Linux account removal failed; restoring MUB-X identity." >&2
    exit 1
  fi
fi

# Remove stable subscription credentials that mubx-users does not own.
rm -f "${MUBX_SUB_TOKEN_DIR:-/etc/mubx/sub-tokens}/$target_user" "${MUBX_SS2022_DIR:-/etc/mubx/ss2022-keys}/$target_user"

mubx_box_top "USER DELETED" "SUCCESS"
mubx_kvrow "Account" "$target_user"
mubx_kvrow "Status" "Revoked from SSH, VPNs, Xray, and Subscription server"
mubx_box_bot
printf '\n'
