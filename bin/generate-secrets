#!/bin/bash
set -euo pipefail
umask 077
ENV_FILE="/etc/telecom-engine.env"
if [ -f "$ENV_FILE" ] && grep -q "UUID=" "$ENV_FILE"; then
  if ! grep -q "ZIVPN_PASS=" "$ENV_FILE"; then
    printf 'ZIVPN_PASS="%s"\n' "$(openssl rand -hex 16)" >> "$ENV_FILE"
  fi
  if ! grep -q "SSH_WS_PATH=" "$ENV_FILE"; then
    printf 'SSH_WS_PATH="/ssh-%s"\n' "$(openssl rand -hex 16)" >> "$ENV_FILE"
  fi
  if ! grep -q "SHADOWTLS_PASS=" "$ENV_FILE"; then
    printf 'SHADOWTLS_PASS="%s"\n' "$(openssl rand -hex 16)" >> "$ENV_FILE"
  fi
  if ! grep -q "SHADOWTLS_SNI=" "$ENV_FILE"; then
    printf 'SHADOWTLS_SNI="www.microsoft.com"\n' >> "$ENV_FILE"
  fi
  # Reality was removed from MUB-X; drop any keys older installs wrote.
  sed -i -E '/^(REALITY_|SHORT_ID=)/d' "$ENV_FILE"
  echo "[*] Existing secrets updated"
  exit 0
fi
mkdir -p "$(dirname "$ENV_FILE")"
UUID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())')
HP=$(openssl rand -hex 32)
ZP=$(openssl rand -hex 16)
cat > "$ENV_FILE" <<E
DOMAIN="__DOMAIN__"
UUID="$UUID"
HY2_PASS="$HP"
ZIVPN_PASS="$ZP"
SSH_WS_PATH="/ssh-$(openssl rand -hex 16)"
SHADOWTLS_PASS="$(openssl rand -hex 16)"
SHADOWTLS_SNI="www.microsoft.com"
E
chmod 600 "$ENV_FILE"
echo "[*] Secrets generated"
