#!/usr/bin/env bash
# Manage per-user Xray identities on this server.
#
# Every user in the store gets their own UUID on every transport inbound
# (VLESS-WS, VLESS-HTTPUpgrade, XHTTP, VMess, Trojan and VLESS TCP TLS on
# 8443) plus a Shadowsocks WS inbound/password of their own. Removing a user
# revokes just that identity; the rest keep working. Xray's stats API is
# enabled when the store exists, so per-user traffic can be read back for
# the UUID transports. The raw Shadowsocks TCP channel on public 443 carries
# the shared 'admin' identity (raw SS has no per-user multiplexing).
#
# The store lives in /etc/mubx/users.json (override with MUBX_USERS_FILE).
# The first entry ("admin") carries the legacy UUID from install, so older
# shared client links keep working after an upgrade.
#
# Usage:
#   mubx-users                 interactive menu
#   mubx-users list
#   mubx-users add <name> [days]
#   mubx-users remove <name>
#   mubx-users usage [name]    per-user traffic from the Xray stats API
set -Eeuo pipefail

[ "$(id -u)" -eq 0 ] || { echo "[!] Run mubx-users as root." >&2; exit 1; }

source /usr/local/lib/mubx/common.sh
source /usr/local/lib/mubx/render.sh
if [ -r /usr/local/lib/mubx/subscribe.sh ]; then
  source /usr/local/lib/mubx/subscribe.sh
fi
load_mubx_env

STORE="${MUBX_USERS_FILE:-/etc/mubx/users.json}"
TPL_DIR="$(cat /etc/mubx/install-root 2>/dev/null || true)"
[ -d "$TPL_DIR/configs" ] || {
  echo "[!] MUB-X templates not found under $TPL_DIR; re-run install.sh first." >&2
  exit 1
}
XRAY_CFG=/usr/local/etc/xray/config.json
NGINX_CFG=/etc/nginx/nginx.conf

store_require() {
  if [ ! -f "$STORE" ]; then
    echo "[!] No user store at $STORE; re-run install.sh to seed it." >&2
    exit 1
  fi
}

# Regenerate the Xray and Nginx configs from the current store and reload
# both. Every user owns a Shadowsocks WS route (/ss-<user>) in nginx, so a
# store change must re-render nginx.conf as well as the Xray config. Both
# candidates are validated (xray run -test, nginx -t) before the live files
# are swapped; any restart failure rolls both files back atomically.
reload_xray() {
  local tmpdir xray_new nginx_new
  tmpdir="$(mktemp -d)"
  xray_new="$tmpdir/xray.json"
  nginx_new="$tmpdir/nginx.conf"
  if ! mubx_xray_render "$TPL_DIR/configs/xray.json" "$xray_new"; then
    echo "[!] Failed to render the Xray config." >&2
    rm -rf "$tmpdir"
    return 1
  fi
  if ! xray run -test -config "$xray_new"; then
    echo "[!] New Xray config failed validation; nothing was changed." >&2
    rm -rf "$tmpdir"
    return 1
  fi
  if ! mubx_nginx_render "$TPL_DIR/configs/nginx.conf" "$nginx_new"; then
    echo "[!] Failed to render the Nginx config." >&2
    rm -rf "$tmpdir"
    return 1
  fi
  if ! nginx -t -c "$nginx_new" >/dev/null 2>&1; then
    echo "[!] New Nginx config failed validation; nothing was changed." >&2
    rm -rf "$tmpdir"
    return 1
  fi
  cp -a "$XRAY_CFG" "$tmpdir/xray.old"
  cp -a "$NGINX_CFG" "$tmpdir/nginx.old"
  cp -a "$xray_new" "$XRAY_CFG"
  chmod 0600 "$XRAY_CFG"
  cp -a "$nginx_new" "$NGINX_CFG"
  if ! systemctl restart xray || ! systemctl is-active --quiet xray ||
     ! systemctl reload nginx; then
    echo "[!] Service reload failed; rolling back both configs." >&2
    cp -a "$tmpdir/xray.old" "$XRAY_CFG"
    chmod 0600 "$XRAY_CFG"
    cp -a "$tmpdir/nginx.old" "$NGINX_CFG"
    systemctl restart xray || true
    systemctl reload nginx || true
    rm -rf "$tmpdir"
    return 1
  fi
  rm -rf "$tmpdir"
}

name_ok() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{2,31}$ ]]; }
user_exists() { [ "$(jq -r --arg n "$1" '[.[] | select(.name == $n)] | length' "$STORE" 2>/dev/null || printf 0)" -gt 0 ]; }

store_write_backup() { # $1 backup path
  cp -a "$STORE" "$1"
}

cmd_list() {
  store_require
  if [ "$(mubx_users_count "$STORE")" -eq 0 ]; then
    mubx_put "$(printf '  %sNo users configured yet in store.%s' "$C_SLATE" "$C_RESET")"
    return
  fi
  printf '  %s%-12s %-38s %-12s %s%s\n' "$C_PURPLE" "USERNAME" "UUID" "CREATED" "EXPIRY" "$C_RESET"
  mubx_rule
  jq -r '.[] | [.name, .uuid, (.added // ""), (.expiry // "")] | @tsv' "$STORE" |
    while IFS=$'\t' read -r n u a e; do
      local exp_str="${e:-never}"
      local exp_col="$C_MINT"
      if [ "$exp_str" != "never" ]; then
        if [[ "$(date -d "$exp_str" +%s 2>/dev/null || echo 0)" -lt "$(date +%s)" ]]; then
          exp_col="$C_CORAL"
          exp_str="$exp_str (EXPIRED)"
        else
          exp_col="$C_AMBER"
        fi
      fi
      printf '  %s%-12s%s %s%-38s%s %s%-12s%s %s%s%s\n' \
        "$C_BRIGHT" "$n" "$C_RESET" \
        "$C_ELECTRIC" "$u" "$C_RESET" \
        "$C_SLATE" "$a" "$C_RESET" \
        "$exp_col" "$exp_str" "$C_RESET"
    done
}

cmd_add() { # $1 name  $2 days (optional)
  local name="$1" days="${2:-}" backup new uuid expiry added
  store_require
  name_ok "$name" || { warn "Bad username (3-32 chars, lowercase, [a-z0-9_-])"; return 1; }
  user_exists "$name" && { warn "User '$name' already exists."; return 1; }
  uuid="$(cat /proc/sys/kernel/random/uuid)"
  added="$(date -u '+%Y-%m-%d')"
  expiry=""
  if [ -n "$days" ]; then
    [[ "$days" =~ ^[1-9][0-9]*$ ]] || { warn "Days must be a positive integer"; return 1; }
    expiry="$(date -d "+${days} days" '+%Y-%m-%d')"
  fi
  backup="$(mktemp)"
  new="$(mktemp)"
  store_write_backup "$backup"
  jq --arg n "$name" --arg u "$uuid" --arg a "$added" --arg e "$expiry" \
    '. += [{name: $n, uuid: $u, added: $a, expiry: $e}]' "$STORE" > "$new"
  install -m 0600 "$new" "$STORE"
  rm -f "$new"
  if ! reload_xray; then
    install -m 0600 "$backup" "$STORE"
    rm -f "$backup"
    return 1
  fi
  rm -f "$backup"
  log "User $name provisioned (UUID: $uuid | Expires: ${expiry:-never})"
  # Publish/refresh subscription files
  if [ -r /usr/local/lib/mubx/subscribe.sh ]; then
    source /usr/local/lib/mubx/subscribe.sh
    mubx_sub_generate "$name" >/dev/null 2>&1 || true
  fi
}

cmd_remove() { # $1 name
  local name="$1" backup new
  store_require
  if ! user_exists "$name"; then
    printf '  %s↳ No Xray identity found for %s%s\n' "$C_SLATE" "$name" "$C_RESET"
    return 0
  fi
  [ "$name" != "admin" ] || {
    die "Refusing to remove 'admin' (carries legacy shared identity)."
  }
  backup="$(mktemp)"
  new="$(mktemp)"
  store_write_backup "$backup"
  jq --arg n "$name" 'del(.[] | select(.name == $n))' "$STORE" > "$new"
  install -m 0600 "$new" "$STORE"
  rm -f "$new"
  if ! reload_xray; then
    install -m 0600 "$backup" "$STORE"
    rm -f "$backup"
    return 1
  fi
  rm -f "$backup"
  log "User $name revoked; UUID no longer authenticates."
  if [ -r /usr/local/lib/mubx/subscribe.sh ]; then
    source /usr/local/lib/mubx/subscribe.sh
    tok="$(cat "$MUBX_SUB_TOKEN_DIR/$name" 2>/dev/null || true)"
    [ -z "$tok" ] || rm -rf "${MUBX_SUB_DIR:?}/$tok"
    rm -f "$MUBX_SUB_TOKEN_DIR/$name" "$MUBX_SS2022_DIR/$name"
  fi
}

cmd_usage() { # $1 name (optional)
  store_require
  local name="${1:-}" pattern label u e
  if [ -z "$name" ]; then
    mubx_box_top "XRAY TRAFFIC TELEMETRY" "ALL USERS"
    jq -r '.[].name' "$STORE" | while read -r n; do
      cmd_usage "$n"
    done
    mubx_box_bot
    return
  fi
  user_exists "$name" || { warn "User '$name' does not exist."; return 1; }
  
  local up_val=0 down_val=0
  pattern="user>>>${name}@${DOMAIN:-mubx}>>>traffic>>>uplink"
  out="$(xray api statsquery --server=127.0.0.1:10085 --pattern="$pattern" 2>/dev/null || true)"
  up_val="$(printf '%s\n' "$out" | jq -r '.. | objects | select(.name? == $pat) | .value' --arg pat "$pattern" 2>/dev/null | head -n 1 || true)"
  
  pattern="user>>>${name}@${DOMAIN:-mubx}>>>traffic>>>downlink"
  out="$(xray api statsquery --server=127.0.0.1:10085 --pattern="$pattern" 2>/dev/null || true)"
  down_val="$(printf '%s\n' "$out" | jq -r '.. | objects | select(.name? == $pat) | .value' --arg pat "$pattern" 2>/dev/null | head -n 1 || true)"
  
  fmt_bytes() {
    local b="${1:-0}"
    if [ "$b" -ge 1073741824 ]; then
      printf '%.2f GB' "$(awk "BEGIN {print $b/1073741824}")"
    elif [ "$b" -ge 1048576 ]; then
      printf '%.2f MB' "$(awk "BEGIN {print $b/1048576}")"
    elif [ "$b" -ge 1024 ]; then
      printf '%.2f KB' "$(awk "BEGIN {print $b/1024}")"
    else
      printf '%d B' "$b"
    fi
  }

  mubx_put "$(printf '  %s%-12s%s ▲ %-10s  ▼ %-10s' "$C_BRIGHT" "$name" "$C_RESET" "$(fmt_bytes "${up_val:-0}")" "$(fmt_bytes "${down_val:-0}")")"
}

interactive() {
  local action input name days
  while true; do
    mubx_clear
    mubx_box_top "MUB-X IDENTITY STORE" "USERS & TRAFFIC"
    mubx_kvrow "Store Path" "$STORE"
    mubx_kvrow "User Count" "$(mubx_users_count "$STORE")"
    mubx_box_bot
    printf '\n'
    
    cmd_list
    printf '\n  %s[a]%s Add User   %s[r]%s Remove User   %s[u]%s Usage Stats   %s[q]%s Exit\n\n' \
      "$C_ELECTRIC" "$C_RESET" "$C_CORAL" "$C_RESET" "$C_AMBER" "$C_RESET" "$C_SLATE" "$C_RESET"
    printf '  %s❯%s ' "$C_ELECTRIC" "$C_RESET"
    read -r action || break
    case "${action,,}" in
      a|add)
        printf '  Username: '
        read -r name
        printf '  Expiry days (blank = never): '
        read -r days
        cmd_add "$name" "$days" || true
        ;;
      r|remove)
        printf '  Username to remove: '
        read -r name
        cmd_remove "$name" || true
        ;;
      u|usage)
        printf '\n'
        cmd_usage || true
        ;;
      q|quit|0) exit 0 ;;
    esac
    if [ -t 0 ]; then
      printf '\n'
      read -r -p "  Press Enter to continue... " _ || true
    fi
  done
}

cmd="${1:-interactive}"
case "$cmd" in
  list) cmd_list ;;
  add) cmd_add "${2:?usage: mubx-users add <name> [days]}" "${3:-}" ;;
  remove) cmd_remove "${2:?usage: mubx-users remove <name>}" ;;
  usage) cmd_usage "${2:-}" ;;
  interactive) interactive ;;
  *) echo "Unknown command: $cmd (use list/add/remove/usage)" >&2; exit 1 ;;
esac

