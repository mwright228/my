#!/usr/bin/env bash
set -Eeuo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEGACY="${SELF_DIR}/mubx-users-legacy"
ENV_FILE="/usr/local/lib/mubx/mubx-users-transaction-env.sh"
if [ ! -r "$ENV_FILE" ]; then
  REPO_ROOT="$(cat /etc/mubx/install-root 2>/dev/null || true)"
  [ -r "$REPO_ROOT/lib/mubx-users-transaction-env.sh" ] && ENV_FILE="$REPO_ROOT/lib/mubx-users-transaction-env.sh"
fi
if [ -r "$ENV_FILE" ]; then
  export BASH_ENV="$ENV_FILE"
fi

exec "$LEGACY" "$@"
