#!/usr/bin/env bash
# Manage the Reality SNI fronts on this server.
#
# Reality can camouflage against any real HTTPS site. Each front in the list
# gets its own Xray Reality inbound (127.0.0.1:10443+N) and HAProxy SNI
# route, so users on different SIM networks can pick the front their carrier
# allows. The list is stored as REALITY_FRONTS in /etc/telecom-engine.env.
#
# Usage:
#   reality-fronts               interactive menu
#   reality-fronts list
#   reality-fronts add <sni>...      add fronts (validated, reachable)
#   reality-fronts remove <sni>...
#   reality-fronts set <sni>...      replace the whole list (>= 1 front)
set -Eeuo pipefail

[ "$(id -u)" -eq 0 ] || { echo "[!] Run reality-fronts as root." >&2; exit 1; }

source /usr/local/lib/mubx/common.sh
source /usr/local/lib/mubx/reality-build.sh
load_mubx_env

TPL_DIR="$(cat /etc/mubx/install-root 2>/dev/null || true)"
[ -d "$TPL_DIR/configs" ] || {
  echo "[!] MUB-X templates not found under $TPL_DIR; re-run install.sh first." >&2
  exit 1
}
XRAY_CFG=/usr/local/etc/xray/config.json
HAPROXY_CFG=/etc/haproxy/haproxy.cfg
ENV_FILE=/etc/telecom-engine.env

# Print the current list plus extra words, one per line, deduplicated.
merge_fronts() { # $1 current list  rest... words to merge
  printf '%s\n' "$1" "$@" | awk 'NF && !seen[$0]++'
}
# Print the current list minus the words to drop.
minus_fronts() { # $1 current list  rest... words to drop
  local drop=("$@")
  local f skip i
  for f in $1; do
    skip=0
    for ((i = 1; i < ${#drop[@]}; i++)); do
      [ "${drop[$i]}" = "$f" ] && skip=1
    done
    [ "$skip" -eq 0 ] && printf '%s\n' "$f"
  done
}

show_list() {
  reality_fronts
  if [ "${#FRONTS[@]}" -eq 0 ]; then
    printf '  no Reality fronts configured\n'
    return
  fi
  local i=0 f
  for f in "${FRONTS[@]}"; do
    printf '  %s%-3s%s %s\n' "$C_DIM" "$((i + 1))." "$C_RESET" "$f"
    i=$((i + 1))
  done
}

apply_fronts() { # $1 new space separated list
  local new="$1" old="${REALITY_FRONTS:-}" tmpdir
  reality_fronts "$new"
  front_list_validate "${FRONTS[@]}" || return 1
  [ "${#FRONTS[@]}" -ge 1 ] || { echo "[!] At least one front is required." >&2; return 1; }

  tmpdir="$(mktemp -d)"
  cp -a "$XRAY_CFG" "$tmpdir/xray.old"
  cp -a "$HAPROXY_CFG" "$tmpdir/haproxy.old"
  cp -a "$ENV_FILE" "$tmpdir/env.old"

  REALITY_FRONTS="$new"
  if ! mubx_xray_render "$TPL_DIR/configs/xray.json" \
      "$TPL_DIR/configs/reality-inbound.json" "$tmpdir/xray.new"; then
    echo "[!] Failed to render the Xray config." >&2
    rm -rf "$tmpdir"; return 1
  fi
  if ! mubx_haproxy_render "$TPL_DIR/configs/haproxy.cfg" "$tmpdir/haproxy.new"; then
    echo "[!] Failed to render the HAProxy config." >&2
    rm -rf "$tmpdir"; return 1
  fi

  # Validate before touching the live files.
  if ! xray run -test -config "$tmpdir/xray.new"; then
    echo "[!] New Xray config failed validation; nothing was changed." >&2
    rm -rf "$tmpdir"; return 1
  fi
  if ! haproxy -c -f "$tmpdir/haproxy.new"; then
    echo "[!] New HAProxy config failed validation; nothing was changed." >&2
    rm -rf "$tmpdir"; return 1
  fi

  # Swap, persist, restart.
  cp -a "$tmpdir/xray.new" "$XRAY_CFG"
  cp -a "$tmpdir/haproxy.new" "$HAPROXY_CFG"
  mubx_env_set REALITY_FRONTS "$new"
  chmod 0600 "$XRAY_CFG"
  chmod 0644 "$HAPROXY_CFG"
  if ! systemctl restart xray haproxy || ! systemctl is-active --quiet xray ||
     ! systemctl is-active --quiet haproxy; then
    echo "[!] Restart failed; rolling back." >&2
    cp -a "$tmpdir/xray.old" "$XRAY_CFG"
    cp -a "$tmpdir/haproxy.old" "$HAPROXY_CFG"
    mubx_env_set REALITY_FRONTS "$old"
    systemctl restart xray haproxy || true
    rm -rf "$tmpdir"
    return 1
  fi
  rm -rf "$tmpdir"
  printf '  Reality fronts now: %s\n' "$new"
}

interactive() {
  local action input
  while true; do
    mubx_clear
    printf '%sReality SNI fronts%s\n' "$C_BOLD" "$C_RESET"
    mubx_rule
    show_list
    printf '\n  %sa%s  add    %sr%s  remove    %ss%s  replace all    %sq%s  quit\n\n' \
      "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
    read -r -p "  Choose: " action || break
    case "${action,,}" in
      a|add)
        read -r -p "  Fronts to add (space separated): " -a input
        apply_fronts "$(merge_fronts "${REALITY_FRONTS:-}" "${input[@]:-}" | tr '\n' ' ')" || true
        ;;
      r|remove)
        read -r -p "  Fronts to remove (space separated): " -a input
        apply_fronts "$(minus_fronts "${REALITY_FRONTS:-}" "${input[@]:-}" | tr '\n' ' ')" || true
        ;;
      s|set)
        read -r -p "  New front list (space separated): " -a input
        apply_fronts "$(printf '%s\n' "${input[@]:-}" | awk 'NF && !seen[$0]++' | tr '\n' ' ')" || true
        ;;
      q|quit|0) exit 0 ;;
    esac
    read -r -p "  Press Enter to continue... " _ || true
  done
}

cmd="${1:-interactive}"
case "$cmd" in
  list) show_list ;;
  add)
    shift || true
    [ "$#" -ge 1 ] || { echo "Usage: reality-fronts add <sni>..." >&2; exit 1; }
    apply_fronts "$(merge_fronts "${REALITY_FRONTS:-}" "$@" | tr '\n' ' ')"
    ;;
  remove)
    shift || true
    [ "$#" -ge 1 ] || { echo "Usage: reality-fronts remove <sni>..." >&2; exit 1; }
    apply_fronts "$(minus_fronts "${REALITY_FRONTS:-}" "$@" | tr '\n' ' ')"
    ;;
  set)
    shift || true
    [ "$#" -ge 1 ] || { echo "Usage: reality-fronts set <sni>..." >&2; exit 1; }
    apply_fronts "$(printf '%s\n' "$@" | awk 'NF && !seen[$0]++' | tr '\n' ' ')"
    ;;
  *) echo "Unknown command: $cmd (use add/remove/set/list, or no argument for the menu)" >&2; exit 1 ;;
esac
