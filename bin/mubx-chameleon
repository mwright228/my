logging.basicConfig(
    level=getattr(logging, LOG_LEVEL, logging.WARNING),
    format="%(asctime)s [%(levelname)s] [chameleon] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("chameleon")

BIND_ADDR = os.environ.get("CHAMELEON_BIND", "0.0.0.0")
PORTS = [
    int(p.strip())
    for p in os.environ.get("CHAMELEON_PORTS", "8080,3128,8888,18088").split(",")
    if p.strip().isdigit()
]

# Default target when client doesn't specify port (e.g. raw SSH over HTTP)
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 2222

# Local TLS terminator (nginx) — where raw TLS ClientHellos get sent that
# aren't otherwise identified as a specific local service.
TLS_FALLBACK_PORT = int(os.environ.get("CHAMELEON_TLS_FALLBACK_PORT", "20443"))

# Permitted internal local targets (services requiring their own cryptographic auth)
ALLOWED_LOCAL_PORTS: Set[int] = {
    22, 53, 80, 109, 443, 1194, 2222, 5667,
    8388, 8389, 8443, 8444, 8448, 17000, 18080, 18500, 20443
}

# Dedicated local tunnel service ports (always route to loopback)
LOCAL_TUNNEL_PORTS: Set[int] = {
    22, 53, 109, 1194, 2222, 5667,
    8388, 8389, 8444, 8448, 17000, 18080, 18500, 20443
}

# Explicitly forbidden local ports (e.g. Chameleon control & telemetry port 18088)
FORBIDDEN_LOCAL_PORTS: Set[int] = {
    18088,
}

BUFFER_SIZE = 65536  # 64KB high-throughput buffer matching kernel TCP tuning
STATS_FILE_PATH = os.environ.get("CHAMELEON_STATS_FILE", "/run/mubx/chameleon-stats.json")

# Auth / abuse controls
REQUIRE_AUTH_FOR_EXTERNAL = os.environ.get("CHAMELEON_REQUIRE_AUTH", "1") == "1"
USERS_FILE = os.environ.get("MUBX_USERS_FILE", "/etc/mubx/users.json")
MAX_CONCURRENT_CONNECTIONS = int(os.environ.get("CHAMELEON_MAX_CONNECTIONS", "2000"))
MAX_CONNECTIONS_PER_IP = int(os.environ.get("CHAMELEON_MAX_PER_IP", "200"))

# Tarpit and dynamic auto-jail configuration
CHAMELEON_TARPIT_THRESHOLD = int(os.environ.get("CHAMELEON_TARPIT_THRESHOLD", "5"))
CHAMELEON_JAIL_DURATION = float(os.environ.get("CHAMELEON_JAIL_DURATION", "300.0"))
CHAMELEON_TARPIT_DELAY = float(os.environ.get("CHAMELEON_TARPIT_DELAY", "10.0"))
MAX_TARPIT_PER_IP = int(os.environ.get("CHAMELEON_MAX_TARPIT_PER_IP", "3"))
_active_tarpits_per_ip: Dict[str, int] = collections.defaultdict(int)

# BadVPN UDPGW configuration
ENABLE_UDPGW = os.environ.get("CHAMELEON_ENABLE_UDPGW", "1") == "1"
