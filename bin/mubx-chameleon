#!/usr/bin/env python3
"""
MUB-X Chameleon Universal Payload Engine (bin/mubx-chameleon).

Telecom-grade HTTP CONNECT & Injection Proxy (replaces legacy Squid).
Designed specifically for mobile carrier bug-host payloads (HTTP Injector,
HTTP Custom, NetMod, KPN Tunnel):
  - Zero-rejection state machine: never returns 400 Bad Request on split
    payloads ([split], [delay_split]), leading/trailing CRLFs, front/back
    inject headers (X-Online-Host, Host:), or custom methods.
  - Pipelined payload preservation: forwards any buffered payload data
    following the HTTP header directly to the target service without packet loss.
  - Multi-port listener: binds 8080, 3128, 8888, and loopback 18088 (HAProxy
    multiplexed from 443 / 8443 / 2053 / 2083 / 2087 / 2096).
  - Smart Dispatcher: seamlessly bridges to local MUB-X services (Dropbear
    SSH :2222/:109/:53, Sing-box ShadowTLS :8448, SS-2022 :18500,
    wstunnel :18080, SS-443 :17000, ZivPN :5667, OpenVPN :1194) or
    outbound internet targets (:80, :443) with zero-copy stream piping
    and kernel TCP_NODELAY latency elimination.
"""

import asyncio
import logging
import os
import re
import signal
import socket
import sys
from typing import Optional, Set, Tuple

# Configure logging
LOG_LEVEL = os.environ.get("CHAMELEON_LOG", "WARNING").upper()
logging.basicConfig(
    level=getattr(logging, LOG_LEVEL, logging.WARNING),
    format="%(asctime)s [%(levelname)s] [chameleon] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("chameleon")

# Ports to listen on
BIND_ADDR = os.environ.get("CHAMELEON_BIND", "0.0.0.0")
PORTS = [
    int(p.strip())
    for p in os.environ.get("CHAMELEON_PORTS", "8080,3128,8888,18088").split(",")
    if p.strip().isdigit()
]

# Default target when client doesn't specify port (e.g. raw SSH over HTTP)
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 2222

# Permitted internal local targets
ALLOWED_LOCAL_PORTS = {
    22, 53, 80, 109, 443, 1194, 2222, 5667, 8388, 8389, 8443, 8448,
    17000, 18080, 18500, 20443
}

# Dedicated local tunnel service ports (always route to loopback)
LOCAL_TUNNEL_PORTS = {
    22, 53, 109, 1194, 2222, 5667, 8388, 8389, 8448,
    17000, 18080, 18500, 20443
}

BUFFER_SIZE = 65536  # 64KB high-throughput buffer matching kernel TCP tuning

# Precompiled regexes for lenient payload extraction
RE_CONNECT = re.compile(rb"(?i)\bCONNECT\s+(?:\[([a-fA-F0-9:]+)\]|([a-zA-Z0-9\.\-_]+))(?::(\d+))?")
RE_TARGET_HDR = re.compile(rb"(?i)\r?\n(?:X-Target|X-Real-Host):\s*(?:\[([a-fA-F0-9:]+)\]|([a-zA-Z0-9\.\-_]+))(?::(\d+))?")
RE_HTTP_URL = re.compile(rb"(?i)\b(?:GET|POST|HEAD|OPTIONS|PUT|DELETE|TRACE|PATCH)\s+https?://(?:\[([a-fA-F0-9:]+)\]|([a-zA-Z0-9\.\-_]+))(?::(\d+))?")
RE_HOST_HDR = re.compile(rb"(?i)\r?\n(?:X-Online-Host|X-Forward-Host|Host):\s*(?:\[([a-fA-F0-9:]+)\]|([a-zA-Z0-9\.\-_]+))(?::(\d+))?")


def load_local_identifiers() -> Set[str]:
    """Loads server domain names and localhost variants."""
    ids = {"127.0.0.1", "localhost", "::1", "0.0.0.0"}
    for p in ("/etc/mubx/domain", "/etc/telecom-engine.domain"):
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    dom = f.read().strip().lower()
                    if dom:
                        ids.add(dom)
            except Exception:
                pass
    env_dom = os.environ.get("DOMAIN", "").strip().lower()
    if env_dom:
        ids.add(env_dom)
    return ids


LOCAL_IDS = load_local_identifiers()


def parse_target(buffer: bytes) -> Tuple[Optional[str], Optional[int], bool]:
    """
    Leniently inspects any HTTP injector payload to extract the intended
    target host and port. Returns (host, port, is_connect).
    """
    # 1. Standard or mangled CONNECT request (highest priority)
    m = RE_CONNECT.search(buffer)
    if m:
        raw_host = (m.group(1) or m.group(2)).decode("ascii", errors="ignore")
        port = int(m.group(3).decode("ascii")) if m.group(3) else 443
        return raw_host, port, True

    # 2. Explicit target header (X-Target / X-Real-Host)
    m = RE_TARGET_HDR.search(buffer)
    if m:
        raw_host = (m.group(1) or m.group(2)).decode("ascii", errors="ignore")
        port = int(m.group(3).decode("ascii")) if m.group(3) else DEFAULT_PORT
        return raw_host, port, True

    # 3. Plain HTTP request with absolute URI (e.g. GET http://domain:port/ ...)
    m = RE_HTTP_URL.search(buffer)
    if m:
        raw_host = (m.group(1) or m.group(2)).decode("ascii", errors="ignore")
        port = int(m.group(3).decode("ascii")) if m.group(3) else 80
        return raw_host, port, False

    # 4. Host / X-Online-Host header in split or front/back inject payloads
    m = RE_HOST_HDR.search(buffer)
    if m:
        raw_host = (m.group(1) or m.group(2)).decode("ascii", errors="ignore")
        port = int(m.group(3).decode("ascii")) if m.group(3) else 443
        return raw_host, port, True

    return None, None, False


def is_local_target(host: str, port: int) -> bool:
    """Checks if target host/port refers to a local MUB-X service on this machine."""
    h = host.strip().lower()
    if h in LOCAL_IDS or h in ("127.0.0.1", "localhost", "::1", "0.0.0.0"):
        return True
    if port in LOCAL_TUNNEL_PORTS:
        return True
    return False


def set_tcp_opts(writer: asyncio.StreamWriter):
    """Enables TCP_NODELAY and SO_KEEPALIVE to eliminate latency and preserve NAT pinholes."""
    try:
        sock = writer.get_extra_info("socket")
        if sock:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            if hasattr(socket, "TCP_KEEPIDLE"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 30)
            if hasattr(socket, "TCP_KEEPINTVL"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 10)
            if hasattr(socket, "TCP_KEEPCNT"):
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 3)
    except Exception:
        pass


async def pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    """Bidirectional asynchronous streaming with 64KB chunks."""
    try:
        while not reader.at_eof():
            data = await reader.read(BUFFER_SIZE)
            if not data:
                break
            writer.write(data)
            await writer.drain()
    except (asyncio.CancelledError, ConnectionResetError, BrokenPipeError):
        pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass


async def handle_client(client_reader: asyncio.StreamReader, client_writer: asyncio.StreamWriter):
    """
    Handles an incoming connection, buffering through potential [split] or
    [delay_split] chunks until an actionable HTTP request is received.
    Preserves and forwards all pipelined bytes with zero packet loss.
    """
    set_tcp_opts(client_writer)
    client_addr = client_writer.get_extra_info("peername")
    log.debug("Client connected: %s", client_addr)

    buffer = bytearray()
    target_host = None
    target_port = None
    is_connect = False

    # Accumulate payload chunks (handles [split], [delay_split], leading CRLFs)
    try:
        while len(buffer) < 8192:
            chunk = await asyncio.wait_for(client_reader.read(4096), timeout=5.0)
            if not chunk:
                break
            buffer.extend(chunk)

            # Check if we have enough to identify the target
            th, tp, ic = parse_target(buffer)
            if th:
                target_host, target_port, is_connect = th, tp, ic
                # If we have complete HTTP headers
                if b"\r\n\r\n" in buffer or b"\n\n" in buffer:
                    # If this is not a CONNECT request and not a websocket upgrade,
                    # peek briefly (up to 100ms) to see if a split CONNECT payload follows
                    if not is_connect and b"upgrade: websocket" not in bytes(buffer).lower():
                        try:
                            more = await asyncio.wait_for(client_reader.read(4096), timeout=0.10)
                            if more:
                                buffer.extend(more)
                                th2, tp2, ic2 = parse_target(buffer)
                                if th2 and ic2:
                                    target_host, target_port, is_connect = th2, tp2, ic2
                        except (asyncio.TimeoutError, ConnectionResetError):
                            pass
                    break
    except (asyncio.TimeoutError, ConnectionResetError):
        pass

    if not buffer:
        client_writer.close()
        return

    # Extract any pipelined data immediately following HTTP request headers
    header_end = -1
    idx = buffer.find(b"\r\n\r\n")
    if idx != -1:
        header_end = idx + 4
    else:
        idx = buffer.find(b"\n\n")
        if idx != -1:
            header_end = idx + 2

    leftover = bytes(buffer[header_end:]) if (header_end != -1 and header_end < len(buffer)) else b""

    # Fallback to default Dropbear SSH if no host could be parsed
    if not target_host:
        target_host = DEFAULT_HOST
        target_port = DEFAULT_PORT
        is_connect = True

    # Normalize local loopback destinations (bypasses cloud NAT hairpinning)
    if is_local_target(target_host, target_port):
        target_host = "127.0.0.1"
        if target_port not in ALLOWED_LOCAL_PORTS:
            log.warning("Blocked local port access: %s:%d from %s", target_host, target_port, client_addr)
            client_writer.write(b"HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
            await client_writer.drain()
            client_writer.close()
            return

    # Check for direct SSH over HTTP (e.g. GET / with Upgrade: websocket)
    buf_lower = bytes(buffer).lower()
    is_ws_direct = (not is_connect) and (b"upgrade: websocket" in buf_lower)
    if is_ws_direct and target_host == "127.0.0.1" and target_port in (80, 443):
        # Direct websocket injection to SSH
        target_port = DEFAULT_PORT
        is_connect = True

    # Connect to target service
    log.info("Connecting %s -> %s:%d (is_connect=%s, leftover=%d B)",
             client_addr, target_host, target_port, is_connect, len(leftover))
    try:
        target_reader, target_writer = await asyncio.wait_for(
            asyncio.open_connection(target_host, target_port), timeout=6.0
        )
        set_tcp_opts(target_writer)
    except Exception as e:
        log.warning("Failed connecting to %s:%d: %s", target_host, target_port, e)
        try:
            client_writer.write(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
            await client_writer.drain()
            client_writer.close()
        except Exception:
            pass
        return

    # Acknowledge handshake with carrier-demanded status code
    try:
        if is_connect or is_ws_direct:
            if b"upgrade: websocket" in buf_lower:
                client_writer.write(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
            elif b"200 ok" in buf_lower:
                client_writer.write(b"HTTP/1.1 200 OK\r\n\r\n")
            elif b"http/1.0" in buf_lower[:30]:
                client_writer.write(b"HTTP/1.0 200 Connection established\r\n\r\n")
            else:
                client_writer.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
            await client_writer.drain()

            # Forward any pipelined payload bytes (e.g. SSH identification string or TLS hello)
            if leftover:
                target_writer.write(leftover)
                await target_writer.drain()
        else:
            # For plain GET/POST to external web targets, forward the HTTP request
            target_writer.write(buffer)
            await target_writer.drain()
    except Exception as e:
        log.debug("Error sending handshake ack: %s", e)
        client_writer.close()
        target_writer.close()
        return

    # Start bidirectional zero-copy pipe and cleanly teardown on first close
    pipe_client = asyncio.create_task(pipe(client_reader, target_writer))
    pipe_target = asyncio.create_task(pipe(target_reader, client_writer))
    done, pending = await asyncio.wait([pipe_client, pipe_target], return_when=asyncio.FIRST_COMPLETED)
    for task in pending:
        task.cancel()
    for writer in (client_writer, target_writer):
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass


async def main():
    servers = []
    for port in PORTS:
        try:
            listen_ip = "127.0.0.1" if port == 18088 else BIND_ADDR
            try:
                server = await asyncio.start_server(handle_client, listen_ip, port, reuse_port=True)
            except (TypeError, OSError):
                server = await asyncio.start_server(handle_client, listen_ip, port)
            servers.append(server)
            log.info("MUB-X Chameleon listening on %s:%d", listen_ip, port)
        except Exception as e:
            log.error("Failed to bind on port %d: %s", port, e)

    if not servers:
        sys.exit(1)

    loop = asyncio.get_running_loop()
    stop_event = asyncio.Event()

    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, stop_event.set)
        except NotImplementedError:
            pass

    await stop_event.wait()
    log.info("Shutting down MUB-X Chameleon...")
    for s in servers:
        s.close()
        await s.wait_closed()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        pass
