#!/usr/bin/env bash
# MUB-X bug-host / SNI candidate audit.
source /usr/local/lib/mubx/common.sh

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  read -r -p "  Candidate domain / bug-host to audit: " TARGET
fi
[ -n "$TARGET" ] || { echo "[!] No target specified." >&2; exit 1; }

mubx_clear
printf '%sBug-host audit%s\n' "$C_BOLD" "$C_RESET"
mubx_rule
mubx_kv "Target" "$TARGET"

pass()  { printf '  %s●%s %s\n' "$C_GREEN"  "$C_RESET" "$1"; }
alert() { printf '  %s▲%s %s\n' "$C_YELLOW" "$C_RESET" "$1"; }
fail()  { printf '  %s●%s %s\n' "$C_RED"    "$C_RESET" "$1"; }

printf '\n%s1. DNS resolution%s\n' "$C_BOLD" "$C_RESET"
RESOLVED_IP=$(dig +short "$TARGET" 2>/dev/null | grep -E '^[0-9.]+' | head -n 1)
if [ -n "$RESOLVED_IP" ]; then
  pass "resolves to $RESOLVED_IP"
else
  fail "host does not resolve"
fi

printf '\n%s2. HTTP direct response (port 80)%s\n' "$C_BOLD" "$C_RESET"
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "http://${TARGET}")
case "$HTTP_CODE" in
  200|301|302) pass "HTTP $HTTP_CODE" ;;
  *) alert "HTTP ${HTTP_CODE:-no response}" ;;
esac

printf '\n%s3. TLS 1.3 handshake & RTT%s\n' "$C_BOLD" "$C_RESET"
RTT=$(curl -s -o /dev/null -w "%{time_appconnect}s" --connect-timeout 5 --max-time 8 "https://${TARGET}" 2>/dev/null)
if [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  pass "handshake completed in $RTT"
else
  fail "TLS handshake timed out or was blocked"
fi

printf '\n%s4. Squid CONNECT forwarding (127.0.0.1:8080)%s\n' "$C_BOLD" "$C_RESET"
SQUID_TEST=$(printf "CONNECT ${TARGET}:443 HTTP/1.1\r\nHost: ${TARGET}:443\r\n\r\n" \
  | nc -w 4 127.0.0.1 8080 2>/dev/null | head -n 1)
if echo "$SQUID_TEST" | grep -q "200 Connection established"; then
  pass "CONNECT via Squid returned 200"
else
  alert "non-200 response: ${SQUID_TEST:-timed out}"
fi

mubx_rule
printf '%sVerdict%s\n' "$C_BOLD" "$C_RESET"
if [ -n "$RESOLVED_IP" ] && [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  pass "valid candidate for SNI injection / VLESS-WS routing"
else
  fail "high risk of carrier drops or captive-portal redirection"
fi
mubx_rule
