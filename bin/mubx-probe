#!/usr/bin/env bash
# MUB-X bug-host / SNI candidate audit.
source /usr/local/lib/mubx/common.sh

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  printf '  Candidate domain / bug-host to audit: '
  read -r TARGET
fi
[ -n "$TARGET" ] || die "No target specified."

mubx_clear
mubx_box_top "BUG-HOST & SNI AUDIT" "PROBE"
mubx_kvrow "Target Domain" "$TARGET"
mubx_kvrow "Audit Time"    "$(date '+%Y-%m-%d %H:%M:%S %Z')"
mubx_box_bot
printf '\n'

# --- Collect probe results ------------------------------------------------
RESOLVED_IP=$(dig +short "$TARGET" 2>/dev/null | grep -E '^[0-9.]+' | head -n 1)
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "http://${TARGET}")
RTT=$(curl -s -o /dev/null -w "%{time_appconnect}s" --connect-timeout 5 --max-time 8 "https://${TARGET}" 2>/dev/null)
SQUID_TEST=$(printf "CONNECT ${TARGET}:443 HTTP/1.1\r\nHost: ${TARGET}:443\r\n\r\n" \
  | nc -w 4 127.0.0.1 8080 2>/dev/null | head -n 1)

mubx_group_open "SECURITY & CARRIER PROBE CHECKS"

# 1. DNS resolution
if [ -n "$RESOLVED_IP" ]; then
  mubx_card "  DNS Resolution" "$(mubx_pill OK "$RESOLVED_IP")"
else
  mubx_card "  DNS Resolution" "$(mubx_pill FAIL "UNRESOLVED")"
  mubx_hint "Host did not return any valid A record"
fi

# 2. HTTP direct response (port 80)
case "$HTTP_CODE" in
  200|301|302)
    mubx_card "  HTTP Direct (Port 80)" "$(mubx_pill OK "HTTP $HTTP_CODE")"
    ;;
  *)
    mubx_card "  HTTP Direct (Port 80)" "$(mubx_pill WARN "HTTP ${HTTP_CODE:-NONE}")"
    mubx_hint "Host returned non-standard status code: ${HTTP_CODE:-timed out}"
    ;;
esac

# 3. TLS 1.3 handshake & RTT
if [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  mubx_card "  TLS Handshake & RTT" "$(mubx_pill OK "$RTT")"
  mubx_hint "TLS handshake completed successfully"
else
  mubx_card "  TLS Handshake & RTT" "$(mubx_pill FAIL "TIMEOUT")"
  mubx_hint "TLS handshake timed out or was intercepted/blocked"
fi

# 4. Squid CONNECT forwarding (127.0.0.1:8080)
if echo "$SQUID_TEST" | grep -q "200 Connection established"; then
  mubx_card "  Squid CONNECT Proxy (8080)" "$(mubx_pill OK "200 OK")"
else
  mubx_card "  Squid CONNECT Proxy (8080)" "$(mubx_pill WARN "FAILED")"
  mubx_hint "Proxy response: ${SQUID_TEST:-timed out}"
fi

mubx_group_close

# --- Verdict ----------------------------------------------------------------
mubx_box_top "INSPECTION VERDICT" "ANALYSIS"
if [ -n "$RESOLVED_IP" ] && [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  mubx_put "$(printf '  %s● [OPTIMAL]%s Candidate valid for SNI spoofing & VLESS-WS bypass' "$C_MINT" "$C_RESET")"
else
  mubx_put "$(printf '  %s○ [HIGH RISK]%s Risk of carrier deep-packet drop / redirection' "$C_CORAL" "$C_RESET")"
fi
mubx_box_bot
printf '\n'

