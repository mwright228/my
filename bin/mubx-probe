#!/usr/bin/env bash
# MUB-X bug-host / SNI candidate audit.
source /usr/local/lib/mubx/common.sh

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  read -r -p "  Candidate domain / bug-host to audit: " TARGET
fi
[ -n "$TARGET" ] || { echo "[!] No target specified." >&2; exit 1; }

mubx_clear
mubx_box_line '┌' '┐'
mubx_put "$(printf '  %sMUB-X%s · %sbug-host audit%s' "$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET")"
mubx_box_line '├' '┤'
mubx_kvrow "Target" "$TARGET"
mubx_box_line '└' '┘'
printf '\n'

# --- collect the probe results first --------------------------------------
RESOLVED_IP=$(dig +short "$TARGET" 2>/dev/null | grep -E '^[0-9.]+' | head -n 1)
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "http://${TARGET}")
RTT=$(curl -s -o /dev/null -w "%{time_appconnect}s" --connect-timeout 5 --max-time 8 "https://${TARGET}" 2>/dev/null)
SQUID_TEST=$(printf "CONNECT ${TARGET}:443 HTTP/1.1\r\nHost: ${TARGET}:443\r\n\r\n" \
  | nc -w 4 127.0.0.1 8080 2>/dev/null | head -n 1)

mubx_group_open "Checks"

# 1. DNS resolution
if [ -n "$RESOLVED_IP" ]; then
  mubx_card "  DNS resolution" "$(mubx_dot "$C_GREEN" '●' 'pass')"
  mubx_hint "resolves to $RESOLVED_IP"
else
  mubx_card "  DNS resolution" "$(mubx_dot "$C_RED" '○' 'fail')"
  mubx_hint "host does not resolve"
fi

# 2. HTTP direct response (port 80)
case "$HTTP_CODE" in
  200|301|302)
    mubx_card "  HTTP direct (port 80)" "$(mubx_dot "$C_GREEN" '●' 'pass')"
    mubx_hint "HTTP $HTTP_CODE"
    ;;
  *)
    mubx_card "  HTTP direct (port 80)" "$(mubx_dot "$C_YELLOW" '▲' 'warn')"
    mubx_hint "HTTP ${HTTP_CODE:-no response}"
    ;;
esac

# 3. TLS 1.3 handshake & RTT
if [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  mubx_card "  TLS handshake & RTT" "$(mubx_dot "$C_GREEN" '●' 'pass')"
  mubx_hint "handshake completed in $RTT"
else
  mubx_card "  TLS handshake & RTT" "$(mubx_dot "$C_RED" '○' 'fail')"
  mubx_hint "TLS handshake timed out or was blocked"
fi

# 4. Squid CONNECT forwarding (127.0.0.1:8080)
if echo "$SQUID_TEST" | grep -q "200 Connection established"; then
  mubx_card "  Squid CONNECT (8080)" "$(mubx_dot "$C_GREEN" '●' 'pass')"
  mubx_hint "CONNECT via Squid returned 200"
else
  mubx_card "  Squid CONNECT (8080)" "$(mubx_dot "$C_YELLOW" '▲' 'warn')"
  mubx_hint "non-200 response: ${SQUID_TEST:-timed out}"
fi

mubx_group_close

# --- verdict ----------------------------------------------------------------
printf '%sVerdict%s\n' "$C_BOLD" "$C_RESET"
mubx_box_line '┌' '┐'
if [ -n "$RESOLVED_IP" ] && [ -n "$RTT" ] && [ "$RTT" != "0.000s" ]; then
  mubx_put "$(printf '  %s●%s valid candidate for SNI injection / VLESS-WS routing' "$C_GREEN" "$C_RESET")"
else
  mubx_put "$(printf '  %s○%s high risk of carrier drops or captive-portal redirection' "$C_RED" "$C_RESET")"
fi
mubx_box_line '└' '┘'
