#!/usr/bin/env bash
# MUB-X network & service diagnostics.
set -Eeuo pipefail

DOMAIN=
if [ -r /usr/local/lib/mubx/common.sh ]; then
  source /usr/local/lib/mubx/common.sh
  load_mubx_env 2>/dev/null || true
fi

TARGET="${1:-${DOMAIN:-1.1.1.1}}"
ENDPOINTS=("1.1.1.1" "8.8.8.8" "9.9.9.9")

echo "MUB-X network diagnostics"
echo "Timestamp: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
echo "Target: $TARGET"
printf 'IPv4: '; curl -4 --fail --silent --max-time 5 https://api.ipify.org || echo unavailable
printf 'IPv6: '; curl -6 --fail --silent --max-time 5 https://api64.ipify.org || echo unavailable
printf 'Congestion control: '; cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unavailable
printf 'Default qdisc: '; cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo unavailable
printf 'Default route: '; ip route show default 2>/dev/null | head -n 1 || echo unavailable

echo
echo "ICMP latency/loss:"
for endpoint in "${ENDPOINTS[@]}"; do
  ping -n -c 5 -W 2 "$endpoint" 2>/dev/null |
    awk -v host="$endpoint" \
      '/packet loss/ {loss=$6} /^rtt/ {split($4, a, "/"); avg=a[2]} \
       END {printf "%s loss=%s avg=%s\n", host, loss, (avg=="" ? "n/a" : avg)}'
done

echo
echo "DNS reachability:"
for endpoint in "${ENDPOINTS[@]}"; do
  if timeout 5 getent hosts "$endpoint" >/dev/null 2>&1; then
    echo "$endpoint reachable"
  else
    echo "$endpoint unavailable"
  fi
done

# TCP transports are probed with a connect; UDP transports would always
# "fail" a TCP probe (they have no TCP listener), so their health is
# reported from the local listener table instead.
echo
echo "TCP reachability (connect to $TARGET):"
for spec in "haproxy TLS|443" "nginx HTTP|80" "dropbear SSH|2222" "dropbear SSH alt|109" "openvpn TCP|1194"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if timeout 4 bash -c ":</dev/tcp/$TARGET/$port" 2>/dev/null; then
    printf '  %-18s %s:%s open\n' "$name" "$TARGET" "$port"
  else
    printf '  %-18s %s:%s unavailable\n' "$name" "$TARGET" "$port"
  fi
done

echo
echo "UDP listeners (local check):"
for spec in "openvpn UDP|2200" "hysteria 2|4433" "wireguard|51820" "dnstt|53" "zivpn|5667" "badvpn udpgw|7100" "badvpn udpgw|7500" "badvpn udpgw|7700"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if ss -H -uln "sport = :$port" 2>/dev/null | grep -q .; then
    printf '  %-18s %s listening\n' "$name" "$port"
  else
    printf '  %-18s %s not listening\n' "$name" "$port"
  fi
done

echo
echo "Path MTU probes (to $TARGET):"
for size in 1280 1360 1420 1472; do
  if ping -n -c 1 -W 2 -M do -s "$((size - 28))" "$TARGET" >/dev/null 2>&1; then
    echo "MTU $size: pass"
  else
    echo "MTU $size: fail"
  fi
done

echo
echo "MUB-X services:"
for service in haproxy nginx xray hysteria dnstt dropbear squid wg-quick@wg0; do
  systemctl is-active --quiet "$service" 2>/dev/null &&
    echo "$service: active" || echo "$service: inactive"
done
