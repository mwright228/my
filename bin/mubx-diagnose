#!/usr/bin/env bash
# MUB-X network & service diagnostics.
set -Eeuo pipefail

DOMAIN="$(cat /etc/mubx/domain 2>/dev/null || cat /usr/local/etc/xray/domain 2>/dev/null || true)"
if [ -r /usr/local/lib/mubx/common.sh ]; then
  source /usr/local/lib/mubx/common.sh
elif [ -r "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh" ]; then
  source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
fi
if [ -z "$DOMAIN" ]; then
  load_mubx_env 2>/dev/null || true
fi
diagnose_chameleon() {
  mubx_clear
  mubx_box_top "CHAMELEON UNIVERSAL PROXY AUDIT" "PROBE"
  mubx_kvrow "Timestamp" "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  mubx_box_bot
  printf '\n'

  mubx_group_open "SERVICE STATE & TELEMETRY"
  if systemctl is-active --quiet mubx-chameleon 2>/dev/null; then
    mubx_card "  Daemon Status" "$(mubx_pill UP "ACTIVE")"
  else
    mubx_card "  Daemon Status" "$(mubx_pill DOWN "INACTIVE")"
  fi

  local stats_json="{}"
  if [ -r /run/mubx/chameleon-stats.json ]; then
    stats_json="$(cat /run/mubx/chameleon-stats.json 2>/dev/null || echo '{}')"
  elif stats_resp="$(curl -s --max-time 1 http://127.0.0.1:18088/stats 2>/dev/null)"; then
    stats_json="$stats_resp"
  fi

  if [ "$stats_json" != "{}" ]; then
    local acc act r_loc r_ext blk
    acc="$(printf '%s' "$stats_json" | jq -r '.connections_accepted // 0' 2>/dev/null || echo 0)"
    act="$(printf '%s' "$stats_json" | jq -r '.connections_active // 0' 2>/dev/null || echo 0)"
    r_loc="$(printf '%s' "$stats_json" | jq -r '.routes_local // 0' 2>/dev/null || echo 0)"
    r_ext="$(printf '%s' "$stats_json" | jq -r '.routes_external // 0' 2>/dev/null || echo 0)"
    blk="$(printf '%s' "$stats_json" | jq -r '.blocked_unauthorized // 0' 2>/dev/null || echo 0)"
    mubx_kvrow "Accepted / Active" "$acc / $act"
    mubx_kvrow "Local / Ext Routes" "$r_loc / $r_ext"
    mubx_kvrow "Relay Blocks" "$blk"
  fi
  mubx_group_close

  mubx_group_open "SYNTHETIC PROBES (PORTS 8080, 3128, 8888, 18088)"
  python3 - <<'PY' | while IFS='|' read -r port s1_type s1_label s2_type s2_label s3_type s3_label; do
import socket

def probe(port, payload):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(1.5)
        s.connect(("127.0.0.1", port))
        s.sendall(payload)
        resp = s.recv(512)
        s.close()
        return resp.decode("utf-8", errors="ignore")
    except Exception:
        return ""

for p in [8080, 3128, 8888, 18088]:
    # Probe 1: Local bridge
    resp1 = probe(p, b"CONNECT 127.0.0.1:2222 HTTP/1.1\r\nHost: 127.0.0.1:2222\r\n\r\n")
    s1 = ("UP|BRIDGED 200") if "200 Connection established" in resp1 else ("DOWN|OFFLINE")

    # Probe 2: Unauthenticated external relay (must be 407)
    resp2 = probe(p, b"CONNECT 1.1.1.1:443 HTTP/1.1\r\nHost: 1.1.1.1:443\r\n\r\n")
    if "407 Proxy Authentication Required" in resp2:
        s2 = "OK|BLOCKED 407"
    elif "200 Connection established" in resp2:
        s2 = "WARN|OPEN RELAY!"
    else:
        s2 = "DOWN|OFFLINE"

    # Probe 3: Carrier split payload
    resp3 = probe(p, b"GET http://carrier.bug/ HTTP/1.1\r\nHost: carrier.bug\r\n\r\nCONNECT 127.0.0.1:2222 HTTP/1.1\r\n\r\n")
    s3 = ("PASS|ACCEPTED 200") if "200 Connection established" in resp3 else ("DOWN|OFFLINE")

    print(f"{p}|{s1}|{s2}|{s3}")
PY
    [ -n "$port" ] || continue
    mubx_card "  Port $port: Local Dropbear (:2222)" "$(mubx_pill "$s1_type" "$s1_label")"
    mubx_card "  Port $port: Open Relay Protection" "$(mubx_pill "$s2_type" "$s2_label")"
    mubx_card "  Port $port: Carrier Split Payload" "$(mubx_pill "$s3_type" "$s3_label")"
  done
  mubx_group_close
  exit 0
}

if [ "${1:-}" = "--chameleon" ] || [ "${1:-}" = "-c" ]; then
  diagnose_chameleon
fi

TARGET="${1:-${DOMAIN:-127.0.0.1}}"
ENDPOINTS=("1.1.1.1" "8.8.8.8" "9.9.9.9")

mubx_clear
mubx_box_top "NETWORK & SYSTEM DIAGNOSTICS" "AUDIT"
mubx_kvrow "Audit Target" "$TARGET"
mubx_kvrow "Timestamp"    "$(date '+%Y-%m-%d %H:%M:%S %Z')"
mubx_box_bot
printf '\n'

# --- Host Information -------------------------------------------------------
ipv4="$(curl -4 --fail --silent --max-time 3 https://api.ipify.org 2>/dev/null || echo unavailable)"
ipv6="$(curl -6 --fail --silent --max-time 3 https://api64.ipify.org 2>/dev/null || echo unavailable)"
cc="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unavailable)"
qdisc="$(cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo unavailable)"
route="$(ip route show default 2>/dev/null | head -n 1 || echo unavailable)"

mubx_group_open "HOST KERNEL & NETWORK STACK"
mubx_kvrow "Public IPv4" "$ipv4"
mubx_kvrow "Public IPv6" "$ipv6"
mubx_kvrow "TCP Congestion" "$cc"
mubx_kvrow "Default Qdisc" "$qdisc"
mubx_put "$(printf '  %s%-13s%s %s%s%s' "$C_SLATE" 'Default Route' "$C_RESET" "$C_ELECTRIC" "${route:0:42}" "$C_RESET")"
mubx_group_close

# --- ICMP Latency / Loss ----------------------------------------------------
mubx_group_open "ICMP LATENCY & PACKET LOSS"
for endpoint in "${ENDPOINTS[@]}"; do
  res="$(ping -n -c 5 -W 2 "$endpoint" 2>/dev/null | \
    awk '/packet loss/ {loss=$6} /^rtt/ {split($4, a, "/"); avg=a[2]} \
         END {printf "%s|%s", (loss ? loss : "n/a"), (avg ? avg : "n/a")}')"
  if [ -z "$res" ]; then
    loss='n/a'; avg='n/a'
  else
    loss="${res%%|*}"
    avg="${res#*|}"
  fi
  if [ "$avg" != "n/a" ]; then
    mubx_card "  $endpoint" "$(printf '%s%sms%s  %sloss %s%s' "$C_MINT" "$avg" "$C_RESET" "$C_SLATE" "$loss" "$C_RESET")"
  else
    mubx_card "  $endpoint" "$(printf '%sunreachable%s' "$C_CORAL" "$C_RESET")"
  fi
done
mubx_group_close

# --- DNS Reachability -------------------------------------------------------
mubx_group_open "DNS RESOLUTION"
for endpoint in "${ENDPOINTS[@]}"; do
  if timeout 5 getent hosts "$endpoint" >/dev/null 2>&1; then
    mubx_card "  $endpoint" "$(mubx_pill OK "RESOLVED")"
  else
    mubx_card "  $endpoint" "$(mubx_pill FAIL "TIMEOUT")"
  fi
done
mubx_group_close

# --- TCP Reachability -------------------------------------------------------
mubx_group_open "TCP PORTS ON $TARGET"
for spec in "HAProxy 443 (TLS/SS)|443" "HAProxy 8443 (TLS/SS)|8443" "Nginx Web (80)|80" "Dropbear SSH (2222)|2222" "Dropbear Alt (109)|109" "Dropbear DNS (53)|53" "OpenVPN TCP (1194)|1194" "Shadowsocks TCP (8388)|8388" "Chameleon Proxy (8080)|8080" "Chameleon Alt (3128)|3128" "Chameleon Alt (8888)|8888"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if timeout 4 bash -c 'exec 3<>"/dev/tcp/$1/$2" && exec 3>&-' _ "$TARGET" "$port" 2>/dev/null; then
    mubx_card "  $name" "$(mubx_pill UP "OPEN")"
  else
    mubx_card "  $name" "$(mubx_pill DOWN "CLOSED")"
  fi
done
mubx_group_close

# --- UDP Listeners ----------------------------------------------------------
mubx_group_open "LOCAL UDP LISTENERS"
for spec in "OpenVPN UDP (2200)|2200" "Hysteria 2 QUIC (4433)|4433" "TUIC v5 QUIC (8444)|8444" "WireGuard (51820)|51820" "ZivPN Tunnel (5667)|5667"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if ss -H -uln "sport = :$port" 2>/dev/null | grep -q .; then
    mubx_card "  $name" "$(mubx_pill UP "ACTIVE")"
  else
    mubx_card "  $name" "$(mubx_pill DOWN "OFFLINE")"
  fi
done
for port in 7100 7500 7700; do
  if ss -H -tln "sport = :$port" 2>/dev/null | grep -q .; then
    mubx_card "  BadVPN UDPGW ($port)" "$(mubx_pill UP "ACTIVE")"
  else
    mubx_card "  BadVPN UDPGW ($port)" "$(mubx_pill DOWN "OFFLINE")"
  fi
done
mubx_group_close

# --- Path MTU Probes --------------------------------------------------------
pmtu_target="$TARGET"
if [ "$TARGET" = "127.0.0.1" ] || [ "$TARGET" = "localhost" ] || [ "$TARGET" = "::1" ]; then
  pmtu_target="1.1.1.1"
fi
mubx_group_open "PATH MTU DISCOVERY (TO $pmtu_target)"
for size in 1280 1360 1420 1472; do
  if ping -n -c 1 -W 2 -M do -s "$((size - 28))" "$pmtu_target" >/dev/null 2>&1; then
    mubx_card "  Packet size $size bytes" "$(mubx_pill PASS "NO FRAG")"
  else
    mubx_card "  Packet size $size bytes" "$(mubx_pill FAIL "FRAG REQ")"
  fi
done
mubx_group_close

# --- Firewall Status --------------------------------------------------------
mubx_group_open "FIREWALL & NAT RULES"
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi "status: active"; then
  mubx_card "  UFW Firewall" "$(mubx_pill WARN "ENABLED")"
  mubx_hint "UFW is active: ensure ports 443, 80, 2222, 5667, 8443, 8388, 8448, 8080, 3128 are allowed"
else
  mubx_card "  UFW Firewall" "$(mubx_pill OK "UNRESTRICTED")"
fi
if iptables -t nat -L PREROUTING -n 2>/dev/null | grep -q "5667"; then
  mubx_card "  ZivPN UDP DNAT" "$(mubx_pill UP "REDIRECTING")"
else
  mubx_card "  ZivPN UDP DNAT" "$(mubx_pill OFF "DISABLED")"
fi
mubx_group_close

