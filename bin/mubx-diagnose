#!/usr/bin/env bash
# MUB-X network & service diagnostics.
set -Eeuo pipefail

DOMAIN=
if [ -r /usr/local/lib/mubx/common.sh ]; then
  source /usr/local/lib/mubx/common.sh
  load_mubx_env 2>/dev/null || true
fi

TARGET="${1:-${DOMAIN:-1.1.1.1}}"
ENDPOINTS=("1.1.1.1" "8.8.8.8" "9.9.9.9")

mubx_clear
mubx_box_top "NETWORK & SYSTEM DIAGNOSTICS" "AUDIT"
mubx_kvrow "Audit Target" "$TARGET"
mubx_kvrow "Timestamp"    "$(date '+%Y-%m-%d %H:%M:%S %Z')"
mubx_box_bot
printf '\n'

# --- Host Information -------------------------------------------------------
ipv4="$(curl -4 --fail --silent --max-time 3 https://api.ipify.org 2>/dev/null || echo unavailable)"
ipv6="$(curl -6 --fail --silent --max-time 3 https://api64.ipify.org 2>/dev/null || echo unavailable)"
cc="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unavailable)"
qdisc="$(cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo unavailable)"
route="$(ip route show default 2>/dev/null | head -n 1 || echo unavailable)"

mubx_group_open "HOST KERNEL & NETWORK STACK"
mubx_kvrow "Public IPv4" "$ipv4"
mubx_kvrow "Public IPv6" "$ipv6"
mubx_kvrow "TCP Congestion" "$cc"
mubx_kvrow "Default Qdisc" "$qdisc"
mubx_put "$(printf '  %s%-13s%s %s%s%s' "$C_SLATE" 'Default Route' "$C_RESET" "$C_ELECTRIC" "${route:0:42}" "$C_RESET")"
mubx_group_close

# --- ICMP Latency / Loss ----------------------------------------------------
mubx_group_open "ICMP LATENCY & PACKET LOSS"
for endpoint in "${ENDPOINTS[@]}"; do
  res="$(ping -n -c 5 -W 2 "$endpoint" 2>/dev/null | \
    awk '/packet loss/ {loss=$6} /^rtt/ {split($4, a, "/"); avg=a[2]} \
         END {printf "%s|%s", (loss ? loss : "n/a"), (avg ? avg : "n/a")}')"
  if [ -z "$res" ]; then
    loss='n/a'; avg='n/a'
  else
    loss="${res%%|*}"
    avg="${res#*|}"
  fi
  if [ "$avg" != "n/a" ]; then
    mubx_card "  $endpoint" "$(printf '%s%sms%s  %sloss %s%s' "$C_MINT" "$avg" "$C_RESET" "$C_SLATE" "$loss" "$C_RESET")"
  else
    mubx_card "  $endpoint" "$(printf '%sunreachable%s' "$C_CORAL" "$C_RESET")"
  fi
done
mubx_group_close

# --- DNS Reachability -------------------------------------------------------
mubx_group_open "DNS RESOLUTION"
for endpoint in "${ENDPOINTS[@]}"; do
  if timeout 5 getent hosts "$endpoint" >/dev/null 2>&1; then
    mubx_card "  $endpoint" "$(mubx_pill OK "RESOLVED")"
  else
    mubx_card "  $endpoint" "$(mubx_pill FAIL "TIMEOUT")"
  fi
done
mubx_group_close

# --- TCP Reachability -------------------------------------------------------
mubx_group_open "TCP PORTS ON $TARGET"
for spec in "HAProxy 443 (TLS/SS)|443" "Nginx Web (80)|80" "Dropbear SSH (2222)|2222" "Dropbear Alt (109)|109" "Dropbear DNS (53)|53" "OpenVPN TCP (1194)|1194" "Shadowsocks TCP (8388)|8388"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if timeout 4 bash -c 'exec 3<>"/dev/tcp/$1/$2" && exec 3>&-' _ "$TARGET" "$port" 2>/dev/null; then
    mubx_card "  $name" "$(mubx_pill UP "OPEN")"
  else
    mubx_card "  $name" "$(mubx_pill DOWN "CLOSED")"
  fi
done
mubx_group_close

# --- UDP Listeners ----------------------------------------------------------
mubx_group_open "LOCAL UDP LISTENERS"
for spec in "OpenVPN UDP (2200)|2200" "Hysteria 2 QUIC (4433)|4433" "WireGuard (51820)|51820" "ZivPN Tunnel (5667)|5667"; do
  name="${spec%%|*}"; port="${spec##*|}"
  if ss -H -uln "sport = :$port" 2>/dev/null | grep -q .; then
    mubx_card "  $name" "$(mubx_pill UP "ACTIVE")"
  else
    mubx_card "  $name" "$(mubx_pill DOWN "OFFLINE")"
  fi
done
for port in 7100 7500 7700; do
  if ss -H -tln "sport = :$port" 2>/dev/null | grep -q .; then
    mubx_card "  BadVPN UDPGW ($port)" "$(mubx_pill UP "ACTIVE")"
  else
    mubx_card "  BadVPN UDPGW ($port)" "$(mubx_pill DOWN "OFFLINE")"
  fi
done
mubx_group_close

# --- Path MTU Probes --------------------------------------------------------
mubx_group_open "PATH MTU DISCOVERY (TO $TARGET)"
for size in 1280 1360 1420 1472; do
  if ping -n -c 1 -W 2 -M do -s "$((size - 28))" "$TARGET" >/dev/null 2>&1; then
    mubx_card "  Packet size $size bytes" "$(mubx_pill PASS "NO FRAG")"
  else
    mubx_card "  Packet size $size bytes" "$(mubx_pill FAIL "FRAG REQ")"
  fi
done
mubx_group_close

# --- Firewall Status --------------------------------------------------------
mubx_group_open "FIREWALL & NAT RULES"
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi "status: active"; then
  mubx_card "  UFW Firewall" "$(mubx_pill WARN "ENABLED")"
  mubx_hint "UFW is active: ensure ports 443, 80, 2222, 5667, 8443, 8388, 8448 are allowed"
else
  mubx_card "  UFW Firewall" "$(mubx_pill OK "UNRESTRICTED")"
fi
if iptables -t nat -L PREROUTING -n 2>/dev/null | grep -q "5667"; then
  mubx_card "  ZivPN UDP DNAT" "$(mubx_pill UP "REDIRECTING")"
else
  mubx_card "  ZivPN UDP DNAT" "$(mubx_pill OFF "DISABLED")"
fi
mubx_group_close

