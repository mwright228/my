#!/usr/bin/env bash
# MUB-X subscription server: generate / refresh the per-user subscription
# files served by nginx under /sub/<token>/.
set -Eeuo pipefail

[ "$(id -u)" -eq 0 ] || { echo "[!] Run mubx-sub as root." >&2; exit 1; }

if [ -r /usr/local/lib/mubx/common.sh ]; then
  source /usr/local/lib/mubx/common.sh
  source /usr/local/lib/mubx/render.sh
  source /usr/local/lib/mubx/subscribe.sh
else
  source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
  source "$(dirname "${BASH_SOURCE[0]}")/../lib/render.sh"
  source "$(dirname "${BASH_SOURCE[0]}")/../lib/subscribe.sh"
fi
load_mubx_env 2>/dev/null || true

TX_ACTIVE=0
if [ "${MUBX_USERS_TX_ACTIVE:-0}" != "1" ]; then
  if [ -r /usr/local/lib/mubx/mubx-transaction.sh ]; then
    source /usr/local/lib/mubx/mubx-transaction.sh
  else
    source "$(dirname "${BASH_SOURCE[0]}")/../lib/mubx-transaction.sh"
  fi
  mubx_tx_begin sub
  mubx_tx_snapshot_tree "${MUBX_SUB_DIR:-/var/www/mubx-sub}"
  mubx_tx_snapshot_tree "${MUBX_SS2022_DIR:-/etc/mubx/ss2022-keys}"
  mubx_tx_snapshot_tree "${MUBX_SUB_TOKEN_DIR:-/etc/mubx/sub-tokens}"
  TX_ACTIVE=1
  sub_tx_exit() {
    local status=$?
    if [ "$status" -eq 0 ]; then mubx_tx_commit; else mubx_tx_abort || true; fi
    exit "$status"
  }
  trap sub_tx_exit EXIT
fi

STORE="${MUBX_USERS_FILE:-/etc/mubx/users.json}"

nginx_has_sub_location() { grep -q 'location /sub/' /etc/nginx/nginx.conf 2>/dev/null; }

show_user_sub() {
  local name="$1" url token
  url="$(mubx_sub_generate "$name")" || return 1
  token="$(mubx_sub_token "$name" 2>/dev/null || true)"
  printf '  %s%-14s%s %s%s%s\n' "$C_BRIGHT" "$name" "$C_RESET" "$C_ELECTRIC" "$url" "$C_RESET"
  if [ -n "$token" ] && [ -n "${DOMAIN:-}" ]; then
    if mubx_user_has_proto "$name" "openvpn"; then
      printf '  %s↳ OpenVPN TCP (1194):%s https://%s/sub/%s/openvpn-tcp.ovpn\n' "$C_SLATE" "$C_RESET" "$DOMAIN" "$token"
      printf '  %s↳ OpenVPN UDP (2200):%s https://%s/sub/%s/openvpn-udp.ovpn\n' "$C_SLATE" "$C_RESET" "$DOMAIN" "$token"
    fi
    if mubx_user_has_proto "$name" "wireguard"; then
      printf '  %s↳ WireGuard (51820):%s https://%s/sub/%s/wireguard.conf\n' "$C_SLATE" "$C_RESET" "$DOMAIN" "$token"
    fi
  fi
}

mubx_clear
mubx_box_top "1-CLICK SUBSCRIPTION GENERATOR" "CLIENT ENDPOINTS"
mubx_put "$(printf '  %sPublishing multi-client subscription files for proxy & VPN clients:%s' "$C_SLATE" "$C_RESET")"
mubx_box_bot
printf '\n'

case "${1:-}" in
  '')
    [ -f "$STORE" ] || { warn "No user store at $STORE; nothing to publish."; exit 1; }
    printf '  %s%-14s %s%s\n' "$C_PURPLE" "ACCOUNT" "UNIVERSAL BASE64 / CLASH / SING-BOX SUBSCRIPTION URL" "$C_RESET"
    mubx_rule
    while IFS= read -r name; do [ -n "$name" ] || continue; show_user_sub "$name"; done < <(jq -r '.[].name' "$STORE")
    ;;
  help|-h|--help)
    echo "Usage: mubx-sub [user]"
    echo "  Regenerate the per-user subscription files under /sub/<token>/."
    echo "  With no argument, every user in the store is regenerated."
    ;;
  *)
    [ -f "$STORE" ] || { warn "No user store at $STORE; nothing to publish."; exit 1; }
    show_user_sub "$1"
    ;;
esac

if ! nginx_has_sub_location; then
  printf '\n'
  warn "nginx.conf lacks the /sub/ location - run mubx-update to re-render."
fi
printf '\n'
