[Unit]
Description=MUB-X Chameleon Universal Payload Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mubx-chameleon
Restart=always
RestartSec=3s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
